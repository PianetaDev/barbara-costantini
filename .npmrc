# tslib è richiesto in modo annidato da diverse dipendenze @supabase/* nello
# store isolato di pnpm; sia il require() CJS a runtime su Vercel sia il
# resolver Rolldown/Vite in build hanno fallito a risolverlo in quella
# posizione annidata (vedi incidente prod 2026-07-09). Hoistarlo alla radice
# lo rende risolvibile in modo standard da qualsiasi bundler/runtime.
public-hoist-pattern[]=tslib
