---
// src/pages/index.astro
// Porta 1:1 da app/pages/index.vue.
// SSR esplicito: come ogni altra pagina pubblica (studio, lavori, servizi, contatti)
// l'homepage non va prerenderizzata — legge da Supabase ad ogni richiesta e deve
// riflettere immediatamente le modifiche fatte dall'admin (es. lavori_intro, hero_titolo).
// Senza questo export, @astrojs/vercel con isr.expiration potrebbe applicare la cache CDN
// anche a questa pagina, causando ritardi nella visibilità delle modifiche CMS.
export const prerender = false;
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLavori from '../components/SectionLavori.astro';
import SectionServizi from '../components/SectionServizi.astro';
import { getPageContent, getProgettiInEvidenza } from '../lib/supabase-public';
import { risolviImmagine } from '../utils/imagenes';
import { createSupabaseServerClient } from '../lib/supabase';
import { checkIsAdmin } from '../lib/admin-roles';

let progettiEvidenza: Awaited<ReturnType<typeof getProgettiInEvidenza>> = [];
try {
  progettiEvidenza = await getProgettiInEvidenza();
} catch {
  progettiEvidenza = [];
}

// Sulla home BcSectionLavori.vue veniva usato senza prop `progetti` (v. app/pages/index.vue),
// affidandosi ai suoi 3 progetti di default hardcoded (codice "01"/"02"/"03" = id progetto,
// non "PRJ01" — quel prefisso è usato solo nella pagina di listing /lavori). Ora leggiamo
// i progetti in evidenza da Supabase (colonna in_evidenza) invece dell'array statico.
const progettiHome = progettiEvidenza.map((p) => ({
  slug: p.slug,
  titolo: p.titolo,
  codice: `P${String((p.ordine ?? 0) + 1).padStart(2, '0')}`,
  committente: p.committente,
  tipo: p.tipo,
  immagini: p.immagini,
}));

let pageContent: Record<string, string> = {};
let lavoriContent: Record<string, string> = {};
let serviziContent: Record<string, string> = {};
try { pageContent = await getPageContent('home'); } catch {}
try { lavoriContent = await getPageContent('lavori'); } catch {}
try { serviziContent = await getPageContent('servizi'); } catch {}

const heroTitolo = pageContent.hero_titolo || 'Barbara Costantini Restauro';
const heroTesto = pageContent.hero_testo || '';
// Preferisce il campo lavori_intro/servizi_intro dalla riga "home" (editabile nella pagina
// Admin → Home), con fallback al campo hero_testo nelle rispettive pagine lavori/servizi.
const lavoriTesto = pageContent.lavori_intro || lavoriContent.hero_testo || '';
const serviziTesto = pageContent.servizi_intro || (serviziContent as any).hero_testo || '';
const serviziCta = (serviziContent as any).cta_testo || '';
// Modifica sul posto: solo per un admin loggato (stesso controllo delle pagine admin).
const supabaseSessione = createSupabaseServerClient(Astro.cookies, Astro.request);
const { data: { user: utenteSessione } } = await supabaseSessione.auth.getUser();
const isAdminSessione = !!utenteSessione && (await checkIsAdmin(supabaseSessione, utenteSessione.id));
// La home legge i testi dal database: non deve essere servita dalla cache del CDN,
// altrimenti i visitatori vedono testi vecchi dopo un salvataggio.
Astro.response.headers.set('Cache-Control', 'no-store');
---
<BaseLayout title="Barbara Costantini Restauro" titleIsFull>
  <!-- Hero: testo sx + foto quadrata dx — min-h lascia vedere 64px della sezione sotto -->
  <section class="w-full px-[24px] tablet:px-bc-page overflow-hidden tablet:min-h-[calc(100vh-80px-64px)] tablet:flex tablet:flex-col tablet:justify-center">
    <div class="grid grid-cols-1 tablet:grid-cols-2 tablet:items-center max-w-bc-wrap mx-auto w-full">
      <div class="pt-[48px] pb-0 tablet:py-[80px] tablet:pr-[80px] flex flex-col gap-bc-xl justify-center">
        <h1 class="font-sans text-[28px] lg:text-bc-h1 font-normal text-bc-black tracking-[0.02em] leading-[1.5]">
          {heroTitolo}
        </h1>
        {heroTesto && <p class="font-sans text-bc-body1 font-light text-bc-black tracking-[0.02em] leading-[1.5]">{heroTesto}</p>}
        <div><a href="/studio" class="bc-ghost">Scopri il nostro studio →</a></div>
      </div>
      <div class="aspect-square overflow-hidden my-[32px]">
        <Image src={risolviImmagine('/images/bc-095.jpg')} alt="Barbara Costantini restauro" width={1000} format="webp" quality={80} class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  {isAdminSessione ? (
    <div class="bc-edit" data-edit="lavori_intro" data-testo={lavoriTesto}>
      <SectionLavori progetti={progettiHome} testo={lavoriTesto || undefined} borderTop />
    </div>
  ) : (
    <SectionLavori progetti={progettiHome} testo={lavoriTesto || undefined} borderTop />
  )}
  <SectionServizi imageSrc="/images/bc-002.jpg" imageAlt="I servizi" body={serviziTesto || undefined} ctaLabel={serviziCta || undefined} />
  {isAdminSessione && (
    <>
      <style>{`.bc-edit{cursor:text}.bc-edit:hover{outline:2px dashed #000;outline-offset:8px}.bc-editor{margin:16px 0;font-family:inherit}`}</style>
      <script id="bc-home-content" type="application/json" set:html={JSON.stringify(pageContent)} />
      <script>
        document.querySelectorAll<HTMLElement>('.bc-edit').forEach((box) => {
          box.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target.closest('a, button, textarea, .bc-editor')) return;
            e.preventDefault();
            if (box.querySelector('.bc-editor')) return;
            const campo = box.dataset.edit as string;
            const ed = document.createElement('div');
            ed.className = 'bc-editor';
            ed.innerHTML = '<textarea rows="4" style="width:100%;border:1px solid #000;padding:8px"></textarea><div style="margin-top:8px"><button type="button" class="bc-salva">Salva</button> <button type="button" class="bc-annulla">Annulla</button> <span class="bc-stato"></span></div>';
            const ta = ed.querySelector('textarea') as HTMLTextAreaElement;
            ta.value = box.dataset.testo || '';
            box.prepend(ed);
            (ed.querySelector('.bc-annulla') as HTMLButtonElement).onclick = () => ed.remove();
            (ed.querySelector('.bc-salva') as HTMLButtonElement).onclick = async () => {
              const stato = ed.querySelector('.bc-stato') as HTMLElement;
              const contenuto = JSON.parse(document.getElementById('bc-home-content')!.textContent || '{}');
              contenuto[campo] = ta.value;
              stato.textContent = 'Salvataggio...';
              const res = await fetch('/api/admin/pagine/home', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: contenuto }),
              });
              if (res.ok) location.reload();
              else stato.textContent = 'Non salvato: ' + res.status;
            };
          });
        });
      </script>
    </>
  )}
</BaseLayout>
