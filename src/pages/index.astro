---
// src/pages/index.astro
// Porta 1:1 da app/pages/index.vue.
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLavori from '../components/SectionLavori.astro';
import SectionServizi from '../components/SectionServizi.astro';

// TODO(Task 6): sostituire con `import { PROGETTI } from '../data/progetti';`
// quando il Task 6 crea il file dati reale con tutti i 12 progetti.
const progettiPlaceholder = [
  { slug: 'placeholder-1', titolo: 'Progetto placeholder 1', immagini: [{ src: '/images/bc-001.jpg', label: '01' }] },
  { slug: 'placeholder-2', titolo: 'Progetto placeholder 2', immagini: [{ src: '/images/bc-004.jpg', label: '01' }] },
  { slug: 'placeholder-3', titolo: 'Progetto placeholder 3', immagini: [{ src: '/images/bc-007.jpg', label: '01' }] },
];
---
<BaseLayout title="Barbara Costantini Restauro" titleIsFull>
  <!-- Hero: testo sx + foto quadrata dx -->
  <section class="w-full px-[24px] tablet:px-bc-page overflow-hidden">
    <div class="grid grid-cols-1 tablet:grid-cols-2 tablet:items-center max-w-bc-wrap mx-auto w-full">
      <div class="pt-[48px] pb-0 tablet:py-[80px] tablet:pr-[80px] flex flex-col gap-bc-xl justify-center">
        <h1 class="font-sans text-[28px] lg:text-bc-h1 font-normal text-bc-black tracking-[0.02em] leading-[1.5]">
          Barbara Costantini Restauro&nbsp;&nbsp;Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris rhoncus ipsum vel commodo lacinia.
        </h1>
        <div><a href="/studio" class="bc-ghost">Scopri il nostro studio →</a></div>
      </div>
      <div class="aspect-square overflow-hidden my-[32px]">
        <img src="/images/bc-095.jpg" alt="Barbara Costantini restauro" class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <SectionLavori progetti={progettiPlaceholder} borderTop />
  <SectionServizi imageSrc="/images/bc-002.jpg" imageAlt="I servizi" />
</BaseLayout>
