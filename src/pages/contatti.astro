---
// src/pages/contatti.astro
// Figma: 791:8385 — Contatti: testo sx + immagine square dx
// PIA-75: email/instagram/telefono/indirizzo provengono da bc_page_content (CMS).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageContent } from '../lib/supabase-public';
import { risolviImmagine } from '../utils/imagenes';

export const prerender = false;

let contattiContent: Record<string, string> = {};
try {
  contattiContent = await getPageContent('contatti');
} catch {
  // fallback: defaults used below
}
const email = contattiContent.email || 'bb.costantini@gmail.com';
const instagram = contattiContent.instagram || '@barbara_costantini';
const telefono = contattiContent.telefono || '+39 349 6718022';
const indirizzo = contattiContent.indirizzo || "Largo dell'Olgiata 15 - 00123 Roma";
const instagramUrl = `https://instagram.com/${instagram.replace('@', '')}`;
---
<BaseLayout title="Contatti">
  <section class="w-full px-[24px] tablet:px-bc-page overflow-hidden">
    <div class="grid grid-cols-1 tablet:grid-cols-2 tablet:items-center max-w-bc-wrap mx-auto w-full">

      <!-- Testo sx: allineato più internamente (pl cresce da tablet a lg) -->
      <div class="pt-[48px] pb-0 tablet:py-[80px] tablet:pl-[40px] lg:pl-[80px]">
        <div class="flex flex-col gap-[32px]">
          <h1 class="font-sans text-[28px] lg:text-bc-h1 font-normal text-bc-black tracking-[0.02em] leading-[1.5]">
            Contatti
          </h1>
          <div class="flex flex-col gap-[16px]">
            <a
              href={`mailto:${email}`}
              class="font-sans text-bc-body1 font-light text-bc-black tracking-[0.02em] leading-[1.5] hover:underline"
            >
              {email}
            </a>
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-sans text-bc-body1 font-light text-bc-black tracking-[0.02em] leading-[1.5] hover:underline"
            >
              {instagram}
            </a>
            <p class="font-sans text-bc-body1 font-light text-bc-black tracking-[0.02em] leading-[1.5]">
              {telefono}
            </p>
            <p class="font-sans text-bc-body1 font-light text-bc-black tracking-[0.02em] leading-[1.5]">
              {indirizzo}
            </p>
          </div>
        </div>
      </div>

      <!-- Immagine dx: aspect-square, come home hero -->
      <div class="aspect-square overflow-hidden my-[32px]">
        <Image src={risolviImmagine('/images/bc-055.jpg')} alt="Restauro" width={1000} format="webp" quality={80} class="w-full h-full object-cover" />
      </div>

    </div>
  </section>
</BaseLayout>
