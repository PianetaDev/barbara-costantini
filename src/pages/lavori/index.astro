---
// src/pages/lavori/index.astro
// Figma: 780:5242 — Lavori: hero split h1 sx + body dx, griglia card max-w-bc-wrap
// Porta 1:1 da app/pages/lavori/index.vue. v-reveal rimosso pulito (task #47).
// Task 17: i progetti arrivano da Supabase (bc_projects) via getProgetti(), non più
// dall'array statico src/data/progetti.ts.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProgetti } from '../../lib/supabase-public';
import { risolviImmagine } from '../../utils/imagenes';

// output: 'server' (astro.config.mjs) rende già questa pagina SSR di default;
// l'export esplicito documenta che NON va mai prerenderizzata, dato che i dati
// arrivano da Supabase ad ogni richiesta e non sono noti a build-time.
export const prerender = false;

// Fix code review Task 17: senza try/catch, un errore Supabase (rete, downtime,
// rate limit) qui produceva un 500 grezzo per qualunque visitatore pubblico.
// Fallback minimo: griglia vuota — la pagina si renderizza comunque invece di
// crashare (nessun banner/messaggio dedicato, non richiesto per questo fix).
let progettiDb: Awaited<ReturnType<typeof getProgetti>> = [];
try {
  progettiDb = await getProgetti();
} catch (err) {
  // Senza questo log, un guasto di config (Supabase giù, anon key ruotata, RLS
  // rotta) rende /lavori silenziosamente vuota per ogni visitatore — nessun
  // errore visibile, nessun log. Stesso pattern di bug scoperto oggi su
  // Apotheke (fallback MOCK_* silenzioso), corretto qui allo stesso modo.
  console.error('[lavori/index] getProgetti() ha fallito, fallback su griglia vuota:', err)
  progettiDb = []
}
// bc_projects.id è uno uuid generato da Supabase (gen_random_uuid()), non più il
// codice progressivo "01".."12" del vecchio array statico: ricostruiamo lo stesso
// formato di visualizzazione ("PRJ01"...) dalla colonna `ordine` (0-based, stesso
// ordine di inserimento del seed — vedi scripts/seed-bc-cms.mjs).
const progetti = progettiDb.map((p) => ({
  codice: `PRJ${String(p.ordine + 1).padStart(2, '0')}`,
  committente: p.committente,
  titolo: p.titolo,
  slug: p.slug,
  tipo: p.tipo,
  image: p.immagini[0]?.src,
}));
---
<BaseLayout title="Lavori">
  <!-- Hero: h1 sx + body dx — Figma 780:5269 -->
  <section class="w-full px-[24px] tablet:px-bc-page border-b border-bc-black overflow-hidden">
    <div class="grid grid-cols-1 tablet:grid-cols-2 max-w-bc-wrap mx-auto w-full
                py-[48px] tablet:py-[64px] gap-y-[32px] tablet:gap-y-0">
      <div class="flex flex-col justify-start tablet:pr-[80px]">
        <h1 class="font-sans text-[28px] lg:text-bc-h1 font-normal text-bc-black tracking-[0.02em] leading-[1.5]">
          I lavori&nbsp;&nbsp;Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris rhoncus ipsum vel.
        </h1>
      </div>
      <div class="flex items-start justify-center tablet:pl-[40px] lg:pl-0">
        <div class="lg:w-[442px] tablet:pt-[12px] lg:pt-[18px]">
          <p class="font-sans text-bc-body1 font-light text-bc-black tracking-[0.02em] leading-[1.5]">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris rhoncus ipsum vel commodo lacinia.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Griglia progetti — Figma 780:5243 -->
  <section class="w-full px-[24px] tablet:px-bc-page pt-[48px] tablet:pt-[64px] pb-[64px] tablet:pb-[80px]">
    <div class="max-w-bc-wrap mx-auto w-full
                grid grid-cols-1 sm:grid-cols-2 tablet:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 bc:grid-cols-6
                gap-x-[16px] tablet:gap-x-[24px] gap-y-bc-2xl items-start">
      {progetti.map((p) => (
        <a
          href={`/lavori/${p.slug}`}
          class="flex flex-col gap-[16px] group text-left"
        >
          <div
            class="w-full bg-bc-black/10 overflow-hidden ring-0 group-hover:ring-1 group-hover:ring-bc-black transition-shadow"
            style={p.tipo === 'vertical' ? 'aspect-ratio:209/260' : 'aspect-ratio:209/139'}
          >
            {p.image && (
              <Image
                src={risolviImmagine(p.image)}
                alt={p.titolo}
                width={500}
                format="webp"
                quality={80}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            )}
          </div>
          <div class="flex flex-col gap-[4px]">
            <p class="font-sans text-bc-label2 font-light text-bc-black tracking-[0.028em]">{p.codice}</p>
            <p class="font-sans text-bc-label2 font-light text-bc-black tracking-[0.028em]">{p.committente}</p>
            <p class="font-sans text-bc-h4 font-normal text-bc-black tracking-[0.02em] group-hover:underline">{p.titolo}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
