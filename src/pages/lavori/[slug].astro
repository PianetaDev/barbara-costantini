---
// src/pages/lavori/[slug].astro
// Dettaglio lavoro accessibile da Lavori-Bis: layout full, no "prossimo progetto",
// BcSectionLavori al fondo. Porta da app/pages/lavori/[slug].vue.
// v-reveal rimosso pulito (task #47). font-garamond -> font-sans.
//
// Task 17: il progetto arriva da Supabase (bc_projects) via getProgetto(slug), non
// più dall'array statico src/data/progetti.ts. Con questo, `getStaticPaths` non ha
// più senso (gli slug non sono noti a build-time — un admin può aggiungerne di
// nuovi via CRUD, Task 11): la pagina diventa dinamica/SSR, come già di default per
// output: 'server' (astro.config.mjs).
//
// NOTA sulla forma dei dati: la riga restituita da Supabase NON ha più `meta`
// (Committente/Anno annidati in un array) né `immaginiContenuto` — quest'ultimo
// campo non è mai esistito nello schema bc_projects (vedi
// supabase/migrations/20260708100000_bc_cms_schema.sql) né nel CRUD admin (vedi
// src/lib/validation/progetto.ts) né nello script di seed (scripts/seed-bc-cms.mjs):
// è un gap di modellazione dati preesistente ai Task 10/11/16, non introdotto qui.
// Le due sezioni che lo usavano ("immagine grande contenuto" e "due immagini
// affiancate") restano nel markup con lo stesso placeholder di sfondo, ma senza
// foto finché quel campo non verrà aggiunto allo schema in un task futuro.
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLavori from '../../components/SectionLavori.astro';
import CaroselloImmagini from '../../components/CaroselloImmagini.vue';
import { getProgetto, getProgetti, ERRORE_RIGA_NON_TROVATA } from '../../lib/supabase-public';
import { risolviImmagine } from '../../utils/imagenes';

export const prerender = false;

const { slug } = Astro.params;

// getProgetto usa `.single()`: se lo slug non corrisponde a nessuna riga, Supabase
// lancia un errore con code === ERRORE_RIGA_NON_TROVATA ("PGRST116") — a differenza
// della versione statica (12 slug noti e validi via getStaticPaths), qui chiunque
// può visitare un URL con uno slug inesistente, quindi va gestito senza far
// crashare l'SSR.
//
// Fix code review Task 17: la versione precedente intercettava QUALSIASI errore
// (non solo "riga non trovata") e faceva un redirect 302 verso /lavori per tutti,
// cioè: (a) un soft-404 scorretto per SEO/crawler ("il contenuto è altrove" invece
// di "non esiste"), e (b) un vero errore Supabase transitorio (rete, downtime) su
// uno slug che ESISTE veniva silenziosamente scambiato per "non trovato" invece di
// propagarsi come errore reale. Ora si distingue esplicitamente il codice PGRST116
// (vero 404, via Astro.rewrite verso src/pages/404.astro) da qualunque altro errore
// (rilanciato: Astro lo gestisce come 500, non fingiamo che il progetto non esista).
let progetto;
try {
  progetto = slug ? await getProgetto(slug) : undefined;
} catch (err) {
  const code = (err as { code?: string } | null)?.code;
  if (code === ERRORE_RIGA_NON_TROVATA) {
    return Astro.rewrite('/404');
  }
  throw err;
}
if (!progetto) {
  return Astro.rewrite('/404');
}

const progettiSuggeriti = await (async () => {
  // Stesso principio del Fix 1 (index.astro/studio.astro): il progetto principale
  // è già caricato con successo a questo punto, un errore Supabase solo su questa
  // seconda query (i "suggerimenti") non deve far crashare l'intera pagina di
  // dettaglio — fallback a nessun suggerimento invece di un 500.
  let tutti: Awaited<ReturnType<typeof getProgetti>> = [];
  try {
    tutti = await getProgetti();
  } catch {
    return [];
  }
  const altri = tutti.filter((p) => p.slug !== progetto.slug);
  const curIdx = tutti.findIndex((p) => p.slug === progetto.slug);
  // prendi i successivi in ordine ciclico, escludendo il corrente
  const sorted = [...altri.slice(curIdx), ...altri.slice(0, curIdx)];
  return sorted.slice(0, 3).map((p) => ({
    slug: p.slug,
    titolo: p.titolo,
    codice: String(p.ordine + 1).padStart(2, '0'),
    committente: p.committente ?? '',
    tipo: p.tipo,
    immagini: p.immagini,
  }));
})();

// CaroselloImmagini.vue è un'isola Vue (client:load): il componente <Image> di
// astro:assets è compilato solo dal compilatore .astro e non è utilizzabile nel
// template di un .vue. Per ottenere comunque l'ottimizzazione sharp (resize +
// webp) qui in frontmatter (eseguito ad ogni richiesta ora che la pagina è SSR)
// processiamo le immagini con getImage() e passiamo al componente Vue direttamente
// gli URL già ottimizzati, invece dei path grezzi verso /images/bc-NNN.jpg.
const immaginiCarosello = await Promise.all(
  progetto.immagini.map(async (img) => {
    const ottimizzata = await getImage({
      src: risolviImmagine(img.src),
      width: img.aspetto === 'v' ? 700 : 1000,
      format: 'webp',
      quality: 80,
    });
    return { ...img, src: ottimizzata.src };
  }),
);

// Committente/Anno erano annidati in `progetto.meta` nell'array statico; nella riga
// Supabase sono colonne dirette. `anno` può essere null (mai valorizzato dal seed
// dei 12 progetti reali, vedi scripts/seed-bc-cms.mjs) — filtrato via se assente.
const metaVoci = [
  { label: 'Committente', valore: progetto.committente },
  { label: 'Anno', valore: progetto.anno },
].filter((m): m is { label: string; valore: string } => Boolean(m.valore));

// `intro` era un array di paragrafi nello statico; nella riga Supabase è una
// stringa unica (i paragrafi sono uniti con "\n\n" dal seed) — si riseparano qui.
const introParagrafi = progetto.intro ? progetto.intro.split('\n\n') : [];
---
<BaseLayout title={progetto.titolo} hideNav>
  <div>
    <!-- Navigazione dettaglio: freccia sx + titolo centrato — issue #19 -->
    <nav class="w-full border-b border-bc-black px-[24px] tablet:px-bc-page">
      <div class="max-w-bc-wrap mx-auto w-full flex items-center py-[16px]">
        <a href="/lavori" class="flex-none flex items-center justify-center w-[40px] h-[40px] text-bc-black" aria-label="Torna ai lavori">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" fill="currentColor"/></svg>
        </a>
        <p class="flex-1 text-center font-sans font-normal text-bc-black tracking-[0.02em] mx-[12px]"
           style="font-size: clamp(16px, 2vw, 20px); line-height:1.5;">
          {progetto.titolo}
        </p>
        <div class="flex-none w-[40px]" aria-hidden="true" />
      </div>
    </nav>

    <!-- Hero + navigation thumbnails carosello: isola Vue (stato immagine attiva) -->
    <CaroselloImmagini client:load immagini={immaginiCarosello} titolo={progetto.titolo} />

    <!-- Metadata + intro -->
    <div class="px-bc-page pt-[64px] pb-[64px]">
      <div class="bc-grid bc-2col bc-442 bc-meta max-w-bc-wrap mx-auto">
        <div class="flex flex-col gap-[12px] bc-sidebar">
          {metaVoci.map((m) => (
            <div class="flex flex-col gap-[4px]">
              <p class="font-sans font-light text-bc-black tracking-[0.02em]" style="font-size:16px; line-height:1.5;">{m.label}:</p>
              <p class="font-sans font-light text-bc-black tracking-[0.02em]" style="font-size:16px; line-height:1.5;">{m.valore}</p>
            </div>
          ))}
        </div>
        <div class="flex flex-col gap-bc-md bc-intro">
          {introParagrafi.map((t) => (
            <p class="font-sans font-light text-bc-black tracking-[0.02em]" style="font-size:18px; line-height:1.5;">{t}</p>
          ))}
        </div>
        <div class="bc-spacer-r" />
      </div>
    </div>

    <!-- Immagine grande contenuto -->
    <div class="px-bc-page pb-[64px] bc-grid bc-2col bc-676">
      <div class="bc-spacer-l" />
      <div style="aspect-ratio:676/451; background:rgba(0,0,0,0.1); overflow:hidden;">
        {progetto.immaginiContenuto?.[0] && (
          <Image src={risolviImmagine(progetto.immaginiContenuto[0])} alt={progetto.titolo} width={1200} format="webp" quality={80} style="width:100%; height:100%; object-fit:cover;" />
        )}
      </div>
      <div class="bc-spacer-r" />
    </div>

    <!-- Sezioni testo -->
    {progetto.sezioni.map((s) => (
      <div class="px-bc-page pb-[64px] bc-grid bc-2col bc-442">
        <div class="bc-spacer-l" />
        <div>
          <h2 class="font-sans text-bc-black tracking-[0.02em]" style="font-size:24px; line-height:1.5; margin-bottom:32px; font-weight:400;">{s.titolo}</h2>
          <h3 class="font-sans text-bc-black tracking-[0.02em]" style="font-size:20px; line-height:1.5; margin-bottom:16px; font-weight:400;">{s.sottotitolo}</h3>
          {s.testi.map((t) => (
            <p class="font-sans font-light text-bc-black tracking-[0.02em]" style="font-size:18px; line-height:1.5; margin-bottom:16px;">{t}</p>
          ))}
        </div>
        <div class="bc-spacer-r" />
      </div>
    ))}

    <!-- Due immagini affiancate -->
    <div class="px-bc-page pb-[64px] bc-grid bc-2col bc-676">
      <div class="bc-spacer-l" />
      <div style="display:flex; gap:24px;">
        <div style="flex:1; min-width:0; aspect-ratio:326/406; background:rgba(0,0,0,0.1); overflow:hidden;">
          {progetto.immaginiContenuto?.[0] && (
            <Image src={risolviImmagine(progetto.immaginiContenuto[0])} alt={progetto.titolo} width={700} format="webp" quality={80} style="width:100%; height:100%; object-fit:cover;" />
          )}
        </div>
        <div style="flex:1; min-width:0; aspect-ratio:326/406; background:rgba(0,0,0,0.1); overflow:hidden;">
          {progetto.immaginiContenuto?.[1] && (
            <Image src={risolviImmagine(progetto.immaginiContenuto[1])} alt={progetto.titolo} width={700} format="webp" quality={80} style="width:100%; height:100%; object-fit:cover;" />
          )}
        </div>
      </div>
      <div class="bc-spacer-r" />
    </div>

    <!-- Testo metodo -->
    {progetto.metodo && (
      <div class="px-bc-page pb-[64px] bc-grid bc-2col bc-442">
        <div class="bc-spacer-l" />
        <div style="display:flex; flex-direction:column; gap:32px;">
          <p class="font-sans font-light text-bc-black tracking-[0.02em]" style="font-size:18px; line-height:1.5;">{progetto.metodo.testi[0]}</p>
          <p class="font-sans font-normal text-bc-black tracking-[0.02em]" style="font-size:18px; line-height:1.5;">"{progetto.metodo.citazione}"</p>
          {progetto.metodo.testi[1] && (
            <p class="font-sans font-light text-bc-black tracking-[0.02em]" style="font-size:18px; line-height:1.5;">{progetto.metodo.testi[1]}</p>
          )}
        </div>
      </div>
    )}

    <!-- Sfoglia altri lavori -->
    <SectionLavori
      progetti={progettiSuggeriti}
      ctaLabel="Vedi tutti"
      paragrafoSize="20px"
      cardTitoloSize="20px"
      borderTop
      borderBottom={false}
    />
  </div>
</BaseLayout>

<style>
  .bc-hero-grid { display: grid; grid-template-rows: auto auto; gap: 0 24px; }
  @media (min-width: 768px) { .bc-hero-grid { grid-template-columns: 120px 1fr; } }
  @media (min-width: 1024px) { .bc-hero-grid { grid-template-columns: 1fr 677px 1fr; } }
  @media (min-width: 768px) {
    .bc-col2-r1 { grid-column: 2; grid-row: 1; }
    .bc-col1-r2 { grid-column: 1; grid-row: 2; align-self: start; }
    .bc-col2-r2 { grid-column: 2; grid-row: 2; }
  }
  .bc-grid { display: grid; gap: 24px; }
  @media (min-width: 768px) { .bc-2col { grid-template-columns: 1fr 2fr; } }
  @media (min-width: 1024px) {
    .bc-442 { grid-template-columns: 1fr 442px 1fr; }
    .bc-676 { grid-template-columns: 1fr 676px 1fr; }
  }
  .bc-spacer-l, .bc-spacer-r { display: none; }
  @media (min-width: 768px) { .bc-spacer-l { display: block; } }
  @media (min-width: 1024px) { .bc-spacer-r { display: block; } }
  @media (min-width: 1024px) {
    .bc-meta { display: block !important; position: relative; }
    .bc-sidebar { position: absolute; top: 0; left: 32px; max-width: calc(50% - 277px); }
    .bc-intro { max-width: 442px; margin: 0 auto; }
    .bc-meta .bc-spacer-r { display: none; }
  }
</style>
