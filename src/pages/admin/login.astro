---
// src/pages/admin/login.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Admin" hideSidebar>
  <section class="w-full max-w-[400px]">
    <h1 class="font-sans text-[24px] font-normal text-bc-black tracking-[0.02em] mb-[32px]">Accedi</h1>
    <form id="login-form" method="POST" action="/api/admin/auth/login" class="flex flex-col gap-bc-md">
      <input type="email" name="email" placeholder="Email" required class="border border-bc-black px-bc-md py-bc-xs" />
      <input type="password" name="password" placeholder="Password" required class="border border-bc-black px-bc-md py-bc-xs" />
      <button type="submit" class="bc-btn">Accedi</button>
      <button type="button" id="forgot-password" class="text-left underline text-sm">Password dimenticata?</button>
      <p id="login-error" class="text-red-600 hidden"></p>
      <p id="login-info" class="hidden"></p>
    </form>
  </section>
  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorEl = document.getElementById('login-error')!;
    const infoEl = document.getElementById('login-info')!;
    const forgotBtn = document.getElementById('forgot-password') as HTMLButtonElement;

    // Mostra l'errore se il server rimanda indietro con ?error=...
    const params = new URLSearchParams(window.location.search);
    if (params.get('error')) {
      errorEl.textContent = params.get('error') === 'missing' ? 'Email e password sono obbligatorie.' : 'Email o password non corrette.';
      errorEl.classList.remove('hidden');
    }

    forgotBtn.addEventListener('click', async () => {
      errorEl.classList.add('hidden');
      infoEl.classList.add('hidden');
      const email = (form.elements.namedItem('email') as HTMLInputElement)?.value;
      if (!email) {
        errorEl.textContent = 'Inserisci la tua email qui sopra, poi clicca di nuovo su "Password dimenticata?".';
        errorEl.classList.remove('hidden');
        return;
      }
      const res = await fetch('/api/admin/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (res.ok) {
        infoEl.textContent = 'Ti abbiamo inviato una email con le istruzioni per impostare una nuova password.';
        infoEl.classList.remove('hidden');
      } else {
        const { error } = await res.json();
        errorEl.textContent = error;
        errorEl.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
