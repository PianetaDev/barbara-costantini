---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import RichTextEditor from '../../../components/admin/RichTextEditor.vue';
import { createSupabaseServerClient } from '../../../lib/supabase';

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const { data: progetto } = await supabase.from('bc_projects').select('*').eq('id', Astro.params.id).single();
if (!progetto) return Astro.redirect('/admin/progetti');
---
<AdminLayout title={progetto.titolo} backHref="/admin/progetti" backLabel="Torna ai lavori">
  <section class="max-w-[680px]">
    <form id="progetto-form" class="flex flex-col gap-bc-md" data-id={progetto.id}>
      <label>Titolo <input name="titolo" value={progetto.titolo} class="border border-bc-black px-bc-md py-bc-xs w-full" /></label>
      <label>Committente <input name="committente" value={progetto.committente ?? ''} class="border border-bc-black px-bc-md py-bc-xs w-full" /></label>
      <label>Anno <input name="anno" value={progetto.anno ?? ''} placeholder="es. 2014-2016" class="border border-bc-black px-bc-md py-bc-xs w-full" /></label>
      <label>Introduzione</label>
      <RichTextEditor client:load name="intro" modelValue={progetto.intro ?? ''} />
      <button type="submit" class="bc-btn">Salva</button>
    </form>
    <p id="progetto-success" class="text-bc-black mt-bc-sm hidden">Salvato.</p>
    <p id="progetto-error" class="text-red-600 mt-bc-sm hidden"></p>

    <div class="mt-[64px] pt-[32px] border-t border-bc-black">
      <button id="elimina-progetto" data-id={progetto.id} class="font-sans text-[14px] font-light text-red-600 underline underline-offset-2 hover:no-underline">
        Elimina questo lavoro
      </button>
    </div>
  </section>
  <script>
    const form = document.getElementById('progetto-form') as HTMLFormElement;
    const errorEl = document.getElementById('progetto-error')!;
    const successEl = document.getElementById('progetto-success')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      successEl.classList.add('hidden');
      const id = form.dataset.id;
      const formData = new FormData(form);
      // formData.get('intro') legge l'<input type="hidden" name="intro"> renderizzato
      // da RichTextEditor.vue (vedi commento nel componente): è un vero discendente
      // di questo <form>, quindi il suo valore corrente arriva qui esattamente come
      // per "titolo"/"committente" — nessun collegamento aggiuntivo necessario.
      const payload = {
        titolo: formData.get('titolo'),
        committente: formData.get('committente'),
        anno: formData.get('anno') || undefined,
        intro: formData.get('intro'),
      };
      const res = await fetch(`/api/admin/progetti/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        successEl.classList.remove('hidden');
      } else {
        const { error } = await res.json();
        errorEl.textContent = typeof error === 'string' ? error : JSON.stringify(error);
        errorEl.classList.remove('hidden');
      }
    });

    document.getElementById('elimina-progetto')?.addEventListener('click', async (e) => {
      const id = (e.currentTarget as HTMLElement).dataset.id;
      if (!confirm('Eliminare questo lavoro? L\'operazione non è reversibile.')) return;
      const res = await fetch(`/api/admin/progetti/${id}`, { method: 'DELETE' });
      if (res.ok) {
        window.location.href = '/admin/progetti';
      } else {
        const { error } = await res.json();
        errorEl.textContent = typeof error === 'string' ? error : JSON.stringify(error);
        errorEl.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
