---
// src/pages/admin/imposta-password.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createSupabaseServerClient, exchangeRecoveryCode } from '../../lib/supabase';

// Il link nell'email di reset porta qui con `?code=...` (PKCE, non un fragment come
// nell'implicit flow). Lo scambio codice→sessione DEVE avvenire con lo stesso client
// che ha generato il code verifier in reset-password.ts — cioè il client server-side
// (i cookie), non un client browser separato: sono due storage/flow diversi e non
// condividono stato. Una volta scambiato, la sessione vive nei cookie e l'endpoint
// /api/admin/auth/update-password (anch'esso server-side) può usarla per aggiornare
// la password senza bisogno di un secondo client lato browser.
const code = Astro.url.searchParams.get('code');
let exchangeError: string | null = null;

if (code) {
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
  exchangeError = await exchangeRecoveryCode(supabase, code);
} else {
  exchangeError = 'Link non valido o scaduto: manca il codice di reset. Richiedi un nuovo link da "Password dimenticata?".';
}
---
<AdminLayout title="Admin" hideSidebar>
  <section class="w-full max-w-[400px]">
    <h1 class="font-sans text-[24px] font-normal text-bc-black tracking-[0.02em] mb-[32px]">Imposta nuova password</h1>
    {exchangeError ? (
      <p class="text-red-600">{exchangeError}</p>
    ) : (
      <form id="set-password-form" class="flex flex-col gap-bc-md">
        <input type="password" name="password" placeholder="Nuova password" required minlength="8" class="border border-bc-black px-bc-md py-bc-xs" />
        <button type="submit" class="bc-btn">Salva</button>
        <p id="set-password-error" class="text-red-600 hidden"></p>
      </form>
    )}
  </section>
  <script>
    const form = document.getElementById('set-password-form') as HTMLFormElement | null;
    const errorEl = document.getElementById('set-password-error');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const res = await fetch('/api/admin/auth/update-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: formData.get('password') }),
      });
      if (res.ok) {
        window.location.href = '/admin/login';
      } else if (errorEl) {
        const { error } = await res.json();
        errorEl.textContent = error;
        errorEl.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
