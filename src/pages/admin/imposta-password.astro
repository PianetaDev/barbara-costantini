---
// src/pages/admin/imposta-password.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Imposta nuova password">
  <section class="px-bc-page py-bc-4xl max-w-md mx-auto">
    <h1 class="text-bc-h1">Imposta nuova password</h1>
    <form id="set-password-form" class="flex flex-col gap-bc-md mt-bc-xl">
      <input type="password" name="password" placeholder="Nuova password" required minlength="8" class="border border-bc-black px-bc-md py-bc-xs" />
      <button type="submit" class="bc-btn">Salva</button>
    </form>
  </section>
  <script>
    // Supabase gestisce il token di reset nell'URL hash automaticamente al caricamento della sessione client-side
    import { createClient } from '@supabase/supabase-js';
    const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
    document.getElementById('set-password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target as HTMLFormElement);
      const { error } = await supabase.auth.updateUser({ password: formData.get('password') as string });
      if (error) alert(error.message);
      else window.location.href = '/admin/login';
    });
  </script>
</BaseLayout>
