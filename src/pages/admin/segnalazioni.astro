---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Dashboard segnalazioni/rilasci servita da Segnale (segnale-phi.vercel.app), embed
// read-only — stessa convenzione già usata su Apotheke. Il `key` è il read_key del
// progetto "barbara-costantini" registrato lato Segnale (vedi segnale/server/api/projects.post.ts).
const embedUrl = 'https://segnale-phi.vercel.app/embed/barbara-costantini?key=83ee0bc274985e414a216e17de21c506';
---

<AdminLayout title="Segnalazioni">
  <section>
    <h1 class="text-bc-h1">Segnalazioni</h1>
    <p class="mt-bc-xs text-bc-black/70">
      Le segnalazioni inviate dal sito (bug, richieste) con il loro stato, e lo storico dei rilasci online.
    </p>
    <div class="mt-bc-md border border-bc-black">
      <iframe src={embedUrl} class="block h-[620px] w-full border-0" title="Segnalazioni e rilasci" loading="lazy" />
    </div>
  </section>
</AdminLayout>
