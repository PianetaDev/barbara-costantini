---
// src/pages/admin/pagine/[page].astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '../../../lib/supabase';
import { pageContentSchema } from '../../../lib/validation/page-content';
import ServiziGruppiEditor from '../../../components/admin/ServiziGruppiEditor.vue';
import ServiziPartnerEditor from '../../../components/admin/ServiziPartnerEditor.vue';

// Riusa l'array della whitelist Zod invece di duplicarlo qui a mano (DRY con
// src/lib/validation/page-content.ts, unica fonte di verità sulle pagine ammesse).
const PAGINE_VALIDE = pageContentSchema.shape.page.options;
const pageParam = Astro.params.page;
const isPaginaValida = (PAGINE_VALIDE as readonly string[]).includes(pageParam ?? '');

// PIA-75: etichette leggibili per ogni campo, per pagina.
const FIELD_LABELS: Record<string, Record<string, string>> = {
  home: {
    hero_titolo: 'Titolo pagina',
    hero_testo: 'Testo sotto il titolo',
    lavori_intro: 'Testo introduttivo sezione Lavori (homepage)',
    servizi_intro: 'Testo introduttivo sezione Servizi (homepage)',
  },
  studio: {
    hero_titolo: 'Titolo pagina Studio',
    hero_testo: 'Testo sotto il titolo',
    bio_ruolo: 'Ruolo di Barbara',
    bio_testo: 'Bio di Barbara',
    bio_immagine: 'Foto bio (URL — usa il pulsante Carica)',
    hero_immagine: 'Foto hero (URL — usa il pulsante Carica)',
  },
  contatti: {
    email: 'Email di contatto',
    instagram: 'Handle Instagram (es. @barbara_costantini)',
    telefono: 'Numero di telefono',
    indirizzo: 'Indirizzo',
  },
  lavori: {
    hero_titolo: 'Titolo pagina',
    hero_testo: 'Testo introduttivo (colonna destra)',
  },
  servizi: {
    hero_titolo: 'Titolo pagina',
    hero_testo: 'Testo introduttivo (colonna destra)',
    cta_testo: 'CTA — Testo finale',
  },
  'privacy-policy': {
    html_body: 'Contenuto Privacy Policy (HTML)',
  },
  'cookie-policy': {
    html_body: 'Contenuto Cookie Policy (HTML)',
  },
  footer: {
    ragione_sociale: 'Ragione sociale',
    piva: 'Partita IVA',
    cf: 'Codice Fiscale',
    anno_copyright: 'Anno copyright',
  },
};
const labelsForPage = FIELD_LABELS[pageParam ?? ''] ?? {};

// Pagina pubblica mostrata nell'anteprima (il footer non ha una pagina sua: si vede in home).
const PERCORSO_PUBBLICO: Record<string, string> = { home: '/', footer: '/' };

// Campi che usano textarea invece di input (testi lunghi).
function isTextarea(chiave: string): boolean {
  return chiave.endsWith('_testo') || chiave.endsWith('_corpo') || chiave.endsWith('_intro') || chiave === 'html_body';
}

// Campi che sono URL di immagini: mostrano un file-upload accanto all'input testo.
function isImageField(chiave: string): boolean {
  return chiave.endsWith('_immagine') || chiave.endsWith('_foto');
}


const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const { data: pagina } = isPaginaValida
  ? await supabase.from('bc_page_content').select('*').eq('page', pageParam).single()
  : { data: null };
// Se la pagina richiesta non è tra le 4 valide E non esiste ancora una riga per essa
// (caso normale per una whitelist inesistente: la query sopra non viene nemmeno
// eseguita), mostriamo "Pagina non trovata" invece di un form vuoto silenzioso — non
// è un problema di sicurezza (RLS blocca comunque scritture non autorizzate, e la
// select pubblica è `using (true)`), ma un form vuoto per una pagina inesistente è
// un'esperienza confusa per chi sta amministrando i contenuti.
const paginaNonTrovata = !isPaginaValida;
// Mostra la bozza se esiste (modifiche non ancora pubblicate), altrimenti il contenuto pubblico.
const content = (pagina?.bozza ?? pagina?.content) ?? {} as Record<string, any>;
const haBozza = !!pagina?.bozza;
const isServizi = pageParam === 'servizi';

// Per la pagina servizi, estrai gli array JSONB per i Vue CRUD components
const initialGruppi = isServizi && Array.isArray(content.gruppi) ? content.gruppi : [];
const initialPartner = isServizi && Array.isArray(content.partner) ? content.partner : [];

// Campi flat della pagina servizi (escludi gli array gestiti dai Vue components)
const serviziFlat: Record<string, string> = isServizi ? {
  hero_titolo: String(content.hero_titolo ?? ''),
  hero_testo: String(content.hero_testo ?? ''),
  cta_testo: String(content.cta_testo ?? ''),
} : {};
---
<AdminLayout title={paginaNonTrovata ? 'Pagina non trovata' : `Pagina: ${pageParam}`} previewSrc={paginaNonTrovata ? undefined : `${PERCORSO_PUBBLICO[pageParam ?? ''] ?? `/${pageParam}`}?anteprima=1`}>
  <section class="max-w-[680px]">
    {paginaNonTrovata ? (
      <>
        <h1 class="text-bc-h1">Pagina non trovata</h1>
        <p class="mt-bc-sm">
          "{pageParam}" non è una pagina gestibile da qui. Pagine disponibili: {PAGINE_VALIDE.join(', ')}.
        </p>
      </>
    ) : (
      <>
        <h1 class="text-bc-h1">Pagina: {pageParam}</h1>
        <p class="mt-bc-sm font-sans text-[13px] font-light text-bc-black/60">
          Mentre scrivi, l'anteprima a destra si aggiorna da sola. Il sito cambia solo quando premi «Salva e pubblica».
        </p>
        <form id="page-form" class="flex flex-col gap-bc-md mt-bc-md" data-page={pageParam} data-servizi={isServizi ? '1' : undefined} data-bozza={haBozza ? '1' : undefined}>
          {isServizi ? (
            <>
              {/* Campi flat: hero + cta */}
              {Object.entries(serviziFlat).map(([chiave, valore]) => (
                <label class="flex flex-col gap-[4px]">
                  <span class="font-sans text-[13px] font-normal text-bc-black tracking-[0.02em]">
                    {labelsForPage[chiave] ?? chiave}
                  </span>
                  {isTextarea(chiave) ? (
                    <textarea
                      name={chiave}
                      rows={4}
                      class="border border-bc-black px-bc-md py-bc-xs w-full font-sans text-[14px] font-light resize-y"
                    >{valore}</textarea>
                  ) : (
                    <input
                      name={chiave}
                      value={valore}
                      class="border border-bc-black px-bc-md py-bc-xs w-full font-sans text-[14px] font-light"
                    />
                  )}
                </label>
              ))}

              {/* CRUD Gruppi */}
              <div class="flex flex-col gap-[4px]">
                <span class="font-sans text-[13px] font-normal text-bc-black tracking-[0.02em]">
                  Gruppi di servizi
                </span>
                <ServiziGruppiEditor client:load name="gruppi" modelValue={initialGruppi} />
              </div>

              {/* CRUD Partner */}
              <div class="flex flex-col gap-[4px]">
                <span class="font-sans text-[13px] font-normal text-bc-black tracking-[0.02em]">
                  Partner
                </span>
                <ServiziPartnerEditor client:load name="partner" modelValue={initialPartner} />
              </div>
            </>
          ) : (
            // Itera sulle chiavi definite in labelsForPage (non su content),
            // così i campi nuovi compaiono anche se non ancora salvati in DB.
            Object.keys(labelsForPage).map((chiave) => {
              const valore = String(content[chiave] ?? '');
              return (
                <div class="flex flex-col gap-[4px]">
                  <span class="font-sans text-[13px] font-normal text-bc-black tracking-[0.02em]">
                    {labelsForPage[chiave]}
                  </span>
                  {isTextarea(chiave) ? (
                    <textarea
                      name={chiave}
                      rows={chiave === 'html_body' ? 20 : 4}
                      class={`border border-bc-black px-bc-md py-bc-xs w-full font-light resize-y${chiave === 'html_body' ? ' font-mono text-[12px]' : ' font-sans text-[14px]'}`}
                    >{valore}</textarea>
                  ) : isImageField(chiave) ? (
                    <>
                      <div class="flex gap-[8px] items-center">
                        <input
                          name={chiave}
                          id={`img-input-${chiave}`}
                          value={valore}
                          class="border border-bc-black px-bc-md py-bc-xs flex-1 min-w-0 font-mono text-[12px] font-light"
                        />
                        <label class="bc-btn cursor-pointer shrink-0 text-[12px] py-[6px] px-[10px]">
                          <span data-upload-label>Carica</span>
                          <input
                            type="file"
                            accept="image/jpeg,image/png,image/webp"
                            class="hidden"
                            data-upload-target={`img-input-${chiave}`}
                            data-upload-preview={`img-preview-${chiave}`}
                          />
                        </label>
                      </div>
                      {/* Miniatura costruita dallo script (URL remoto dello Storage). */}
                      <div id={`img-preview-${chiave}`} data-miniatura={valore || undefined} class="hidden" />
                    </>
                  ) : (
                    <input
                      name={chiave}
                      value={valore}
                      class="border border-bc-black px-bc-md py-bc-xs w-full font-sans text-[14px] font-light"
                    />
                  )}
                </div>
              );
            })
          )}
          <div class="sticky bottom-0 -mx-[40px] px-[40px] py-[16px] bg-bc-canvas border-t border-bc-black flex flex-wrap items-center gap-[16px]">
            <button type="submit" class="bc-btn">Salva e pubblica</button>
            <button type="button" id="scarta-bozza" class:list={['font-sans text-[13px] font-light underline underline-offset-2 hover:no-underline', !haBozza && 'hidden']}>
              Annulla modifiche
            </button>
            <span id="page-stato" role="status" class="font-sans text-[13px] font-light text-bc-black/70">
              {haBozza ? 'Hai modifiche non ancora pubblicate (si vedono solo nell\'anteprima).' : ''}
            </span>
          </div>
        </form>
        <p id="page-error" role="alert" class="text-red-600 mt-bc-sm hidden"></p>
      </>
    )}
  </section>
  <script>
    import { caricaImmagine, erroreRisposta } from '../../../lib/client/upload-immagine';

    const form = document.getElementById('page-form') as HTMLFormElement | null;
    if (form) {
      const page = form.dataset.page!;
      const isServizi = form.dataset.servizi === '1';
      const errorEl = document.getElementById('page-error')!;
      const statoEl = document.getElementById('page-stato')!;
      const scartaBtn = document.getElementById('scarta-bozza')!;

      // Legge i valori del form. Per la pagina servizi i componenti Vue tengono gruppi e
      // partner come JSON dentro input nascosti: qui tornano oggetti.
      function leggiForm(): Record<string, unknown> {
        const content: Record<string, unknown> = Object.fromEntries(new FormData(form!).entries());
        if (isServizi) {
          try { content.gruppi = JSON.parse(String(content.gruppi)); } catch { content.gruppi = []; }
          try { content.partner = JSON.parse(String(content.partner)); } catch { content.partner = []; }
        }
        return content;
      }

      function mostraErrore(msg: string) {
        errorEl.textContent = msg;
        errorEl.classList.toggle('hidden', !msg);
      }

      async function invia(pubblica: boolean): Promise<boolean> {
        let res: Response;
        try {
          res = await fetch(`/api/admin/pagine/${page}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: leggiForm(), pubblica }),
          });
        } catch {
          mostraErrore('Salvataggio non riuscito: controlla la connessione e riprova.');
          return false;
        }
        const errore = await erroreRisposta(res);
        mostraErrore(errore);
        return !errore;
      }

      // ── Anteprima dal vivo ────────────────────────────────────────────────
      // Ogni modifica viene salvata in bozza poco dopo che smetti di scrivere, poi
      // l'anteprima si ricarica: quello che vedi a destra è la pagina vera con i testi nuovi.
      // Il confronto periodico (invece dei soli eventi `input`) cattura anche gli editor
      // Vue e le immagini appena caricate, che cambiano il form senza eventi di tastiera.
      let ultimoSalvato = JSON.stringify(leggiForm());
      let inCorso: Promise<void> | null = null;
      // Da quando si preme «Salva e pubblica» o «Annulla modifiche» il salvataggio in bozza
      // si ferma: una bozza che arriva dopo la pubblicazione la farebbe sembrare non pubblicata
      // (o, peggio, rimetterebbe nel form un testo vecchio).
      let fermo = false;
      let erroriDiFila = 0;
      let timer: number | undefined;
      // Gli editor Vue (gruppi, partner) riscrivono i loro campi nascosti appena montati:
      // finché non tocchi nulla, quello stato è il punto di partenza, non una modifica.
      let toccato = false;
      window.setTimeout(() => { if (!toccato) ultimoSalvato = JSON.stringify(leggiForm()); }, 1200);

      async function salvaBozza() {
        const attuale = JSON.stringify(leggiForm());
        if (fermo || attuale === ultimoSalvato || inCorso) return;
        statoEl.textContent = 'Aggiorno l\'anteprima…';
        let ok = false;
        inCorso = invia(false).then((esito) => { ok = esito; });
        await inCorso;
        inCorso = null;
        if (fermo) return;
        erroriDiFila = ok ? 0 : erroriDiFila + 1;
        // Dopo tre errori di fila (es. sessione scaduta) si smette di riprovare da soli.
        if (erroriDiFila >= 3) window.clearInterval(intervallo);
        if (ok) {
          ultimoSalvato = attuale;
          scartaBtn.classList.remove('hidden');
          statoEl.textContent = 'Anteprima aggiornata. Il sito non è ancora cambiato: premi «Salva e pubblica».';
          window.dispatchEvent(new CustomEvent('preview-refresh'));
        } else {
          statoEl.textContent = '';
        }
      }
      function pianifica() {
        toccato = true;
        if (fermo) return;
        window.clearTimeout(timer);
        timer = window.setTimeout(salvaBozza, 700);
      }
      form.addEventListener('input', pianifica);
      form.addEventListener('change', pianifica);
      form.addEventListener('pointerdown', () => { toccato = true; });
      const intervallo = window.setInterval(() => {
        if (toccato && JSON.stringify(leggiForm()) !== ultimoSalvato) pianifica();
      }, 1500);

      /** Ferma il salvataggio automatico e aspetta quello eventualmente in corso. */
      async function fermaBozza() {
        fermo = true;
        window.clearTimeout(timer);
        if (inCorso) await inCorso;
      }
      function riprendiBozza() {
        fermo = false;
      }

      // ── Salva e pubblica ──────────────────────────────────────────────────
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        await fermaBozza();
        statoEl.textContent = 'Pubblicazione…';
        if (await invia(true)) {
          // Ricarica dal server: i valori mostrati sono quelli letti dal database.
          window.location.reload();
        } else {
          statoEl.textContent = '';
          riprendiBozza();
        }
      });

      // ── Annulla modifiche (scarta la bozza) ───────────────────────────────
      scartaBtn.addEventListener('click', async () => {
        if (!confirm('Annullare le modifiche non pubblicate? Il form torna ai testi che sono ora sul sito.')) return;
        await fermaBozza();
        const res = await fetch(`/api/admin/pagine/${page}`, { method: 'DELETE' });
        const errore = await erroreRisposta(res);
        if (errore) { mostraErrore(errore); riprendiBozza(); }
        else window.location.reload();
      });
    }

    function miniatura(segnaposto: HTMLElement, url: string) {
      // Costruita via DOM (non markup nel sorgente .astro): è un URL remoto dello Storage,
      // fuori dalla pipeline di ottimizzazione delle immagini del sito. Solo https o percorsi interni.
      if (!(url.startsWith('https://') || url.startsWith('/'))) return;
      const img = document.createElement('img');
      img.id = segnaposto.id;
      img.src = url; img.alt = ''; img.width = 80; img.height = 60;
      img.className = 'mt-[4px] w-[80px] h-[60px] object-cover border border-bc-black/20';
      segnaposto.replaceWith(img);
    }
    document.querySelectorAll<HTMLElement>('[data-miniatura]').forEach((el) => miniatura(el, el.dataset.miniatura!));

    // Caricamento immagini per i campi _immagine / _foto
    document.querySelectorAll<HTMLInputElement>('[data-upload-target]').forEach((fileInput) => {
      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        const targetInput = document.getElementById(fileInput.dataset.uploadTarget!) as HTMLInputElement | null;
        const previewEl = document.getElementById(fileInput.dataset.uploadPreview!);
        const etichetta = fileInput.parentElement?.querySelector('[data-upload-label]');
        if (etichetta) etichetta.textContent = 'Carico…';
        try {
          const url = await caricaImmagine(file, 'barbara-costantini-team');
          if (targetInput) {
            targetInput.value = url;
            targetInput.dispatchEvent(new Event('input', { bubbles: true }));
          }
          if (previewEl) miniatura(previewEl, url);
        } catch (err) {
          alert((err as Error).message);
        } finally {
          if (etichetta) etichetta.textContent = 'Carica';
          fileInput.value = '';
        }
      });
    });
  </script>
</AdminLayout>
