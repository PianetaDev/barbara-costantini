---
// src/pages/admin/pagine/[page].astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '../../../lib/supabase';
import { pageContentSchema } from '../../../lib/validation/page-content';
import ServiziGruppiEditor from '../../../components/admin/ServiziGruppiEditor.vue';
import ServiziPartnerEditor from '../../../components/admin/ServiziPartnerEditor.vue';

// Riusa l'array della whitelist Zod invece di duplicarlo qui a mano (DRY con
// src/lib/validation/page-content.ts, unica fonte di verità sulle pagine ammesse).
const PAGINE_VALIDE = pageContentSchema.shape.page.options;
const pageParam = Astro.params.page;
const isPaginaValida = (PAGINE_VALIDE as readonly string[]).includes(pageParam ?? '');

// PIA-75: etichette leggibili per ogni campo, per pagina.
const FIELD_LABELS: Record<string, Record<string, string>> = {
  home: {
    hero_titolo: 'Titolo pagina',
    hero_testo: 'Testo sotto il titolo',
  },
  studio: {
    hero_titolo: 'Titolo pagina Studio',
    hero_testo: 'Testo sotto il titolo',
    bio_ruolo: 'Ruolo di Barbara',
    bio_testo: 'Bio di Barbara',
  },
  contatti: {
    email: 'Email di contatto',
    instagram: 'Handle Instagram (es. @barbara_costantini)',
    telefono: 'Numero di telefono',
    indirizzo: 'Indirizzo',
  },
  lavori: {
    hero_titolo: 'Titolo pagina',
    hero_testo: 'Testo introduttivo (colonna destra)',
  },
  servizi: {
    hero_titolo: 'Titolo pagina',
    hero_testo: 'Testo introduttivo (colonna destra)',
    cta_testo: 'CTA — Testo finale',
  },
  'privacy-policy': {
    html_body: 'Contenuto Privacy Policy (HTML)',
  },
  'cookie-policy': {
    html_body: 'Contenuto Cookie Policy (HTML)',
  },
  footer: {
    ragione_sociale: 'Ragione sociale',
    piva: 'Partita IVA',
    cf: 'Codice Fiscale',
    anno_copyright: 'Anno copyright',
  },
};
const labelsForPage = FIELD_LABELS[pageParam ?? ''] ?? {};

// Campi che usano textarea invece di input (testi lunghi).
function isTextarea(chiave: string): boolean {
  return chiave.endsWith('_testo') || chiave.endsWith('_corpo') || chiave === 'html_body';
}

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const { data: pagina } = isPaginaValida
  ? await supabase.from('bc_page_content').select('*').eq('page', pageParam).single()
  : { data: null };
// Se la pagina richiesta non è tra le 4 valide E non esiste ancora una riga per essa
// (caso normale per una whitelist inesistente: la query sopra non viene nemmeno
// eseguita), mostriamo "Pagina non trovata" invece di un form vuoto silenzioso — non
// è un problema di sicurezza (RLS blocca comunque scritture non autorizzate, e la
// select pubblica è `using (true)`), ma un form vuoto per una pagina inesistente è
// un'esperienza confusa per chi sta amministrando i contenuti.
const paginaNonTrovata = !isPaginaValida;
const content = pagina?.content ?? {} as Record<string, any>;
const isServizi = pageParam === 'servizi';

// Per la pagina servizi, estrai gli array JSONB per i Vue CRUD components
const initialGruppi = isServizi && Array.isArray(content.gruppi) ? content.gruppi : [];
const initialPartner = isServizi && Array.isArray(content.partner) ? content.partner : [];

// Campi flat della pagina servizi (escludi gli array gestiti dai Vue components)
const serviziFlat: Record<string, string> = isServizi ? {
  hero_titolo: String(content.hero_titolo ?? ''),
  hero_testo: String(content.hero_testo ?? ''),
  cta_testo: String(content.cta_testo ?? ''),
} : {};
---
<AdminLayout title={paginaNonTrovata ? 'Pagina non trovata' : `Pagina: ${pageParam}`}>
  <section class="max-w-[680px]">
    {paginaNonTrovata ? (
      <>
        <h1 class="text-bc-h1">Pagina non trovata</h1>
        <p class="mt-bc-sm">
          "{pageParam}" non è una pagina gestibile da qui. Pagine disponibili: {PAGINE_VALIDE.join(', ')}.
        </p>
      </>
    ) : (
      <>
        <h1 class="text-bc-h1">Pagina: {pageParam}</h1>
        <form id="page-form" class="flex flex-col gap-bc-md mt-bc-md">
          {isServizi ? (
            <>
              {/* Campi flat: hero + cta */}
              {Object.entries(serviziFlat).map(([chiave, valore]) => (
                <label class="flex flex-col gap-[4px]">
                  <span class="font-sans text-[13px] font-normal text-bc-black tracking-[0.02em]">
                    {labelsForPage[chiave] ?? chiave}
                  </span>
                  {isTextarea(chiave) ? (
                    <textarea
                      name={chiave}
                      rows={4}
                      class="border border-bc-black px-bc-md py-bc-xs w-full font-sans text-[14px] font-light resize-y"
                    >{valore}</textarea>
                  ) : (
                    <input
                      name={chiave}
                      value={valore}
                      class="border border-bc-black px-bc-md py-bc-xs w-full font-sans text-[14px] font-light"
                    />
                  )}
                </label>
              ))}

              {/* CRUD Gruppi */}
              <div class="flex flex-col gap-[4px]">
                <span class="font-sans text-[13px] font-normal text-bc-black tracking-[0.02em]">
                  Gruppi di servizi
                </span>
                <ServiziGruppiEditor client:load name="gruppi" modelValue={initialGruppi} />
              </div>

              {/* CRUD Partner */}
              <div class="flex flex-col gap-[4px]">
                <span class="font-sans text-[13px] font-normal text-bc-black tracking-[0.02em]">
                  Partner
                </span>
                <ServiziPartnerEditor client:load name="partner" modelValue={initialPartner} />
              </div>
            </>
          ) : (
            Object.entries(content).map(([chiave, valore]) => (
              <label class="flex flex-col gap-[4px]">
                <span class="font-sans text-[13px] font-normal text-bc-black tracking-[0.02em]">
                  {labelsForPage[chiave] ?? chiave}
                </span>
                {isTextarea(chiave) ? (
                  <textarea
                    name={chiave}
                    rows={chiave === 'html_body' ? 20 : 4}
                    class={`border border-bc-black px-bc-md py-bc-xs w-full font-light resize-y${chiave === 'html_body' ? ' font-mono text-[12px]' : ' font-sans text-[14px]'}`}
                  >{String(valore)}</textarea>
                ) : (
                  <input
                    name={chiave}
                    value={String(valore)}
                    class="border border-bc-black px-bc-md py-bc-xs w-full font-sans text-[14px] font-light"
                  />
                )}
              </label>
            ))
          )}
          <button type="submit" class="bc-btn">Salva</button>
        </form>
        <p id="page-success" class="text-bc-black mt-bc-sm hidden">Salvato.</p>
        <p id="page-error" class="text-red-600 mt-bc-sm hidden"></p>
      </>
    )}
  </section>
  <script define:vars={{ page: pageParam, isServizi }}>
    const form = document.getElementById('page-form');
    if (form) {
      const errorEl = document.getElementById('page-error');
      const successEl = document.getElementById('page-success');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');
        successEl.classList.add('hidden');
        const formData = new FormData(form);
        const content = Object.fromEntries(formData.entries());
        // Per la pagina servizi, i Vue components serializzano gruppi/partner come
        // JSON string nei hidden inputs. Li parsiamo in oggetti prima di inviare.
        if (isServizi) {
          try { content.gruppi = JSON.parse(content.gruppi); } catch { content.gruppi = []; }
          try { content.partner = JSON.parse(content.partner); } catch { content.partner = []; }
        }
        const res = await fetch(`/api/admin/pagine/${page}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        if (res.ok) {
          successEl.classList.remove('hidden');
        } else {
          const { error } = await res.json();
          errorEl.textContent = typeof error === 'string' ? error : JSON.stringify(error);
          errorEl.classList.remove('hidden');
        }
      });
    }
  </script>
</AdminLayout>
