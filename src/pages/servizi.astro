<BaseLayout title="Servizi">
  <!-- Hero: split h1 sx + body dx — come pagina Lavori -->
  <section class="w-full px-[24px] tablet:px-bc-page border-b border-bc-black overflow-hidden">
    <div class="grid grid-cols-1 tablet:grid-cols-2 max-w-bc-wrap mx-auto w-full
                py-[48px] tablet:py-[64px] gap-y-[32px] tablet:gap-y-0">
      <div class="flex flex-col justify-start tablet:pr-[80px]">
        <h1 class="font-sans text-[28px] lg:text-bc-h1 font-normal text-bc-black tracking-[0.02em] leading-[1.5]">
          I servizi&nbsp;&nbsp;Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris rhoncus ipsum vel.
        </h1>
      </div>
      <div class="flex items-start justify-center tablet:pl-[40px] lg:pl-0">
        <div class="lg:w-[442px] tablet:pt-[12px] lg:pt-[18px]">
          <p class="font-sans text-bc-body1 font-light text-bc-black tracking-[0.02em] leading-[1.5]">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris rhoncus ipsum vel commodo lacinia.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gruppi accordion — layout SectionBio: immagine sx + divider + accordion dx -->
  {gruppi.map((gruppo) => (
    <section class="w-full border-b border-bc-black px-[24px] tablet:px-bc-page overflow-hidden">
      <div class="mx-auto max-w-bc-content w-full
                  flex flex-col tablet:flex-row tablet:items-center xl:justify-between
                  py-[48px] tablet:py-0
                  gap-y-bc-xl tablet:gap-y-0">

        <!-- Immagine sx: flex-1 fino a xl, 443px fissi da xl -->
        <div class="flex items-center tablet:flex-1 xl:flex-none xl:shrink-0 tablet:py-[80px]">
          <div class="w-full xl:w-[443px] aspect-[443/553] bg-bc-black/10 overflow-hidden">
            <Image src={risolviImmagine(gruppo.image)} alt={gruppo.titolo} width={900} format="webp" quality={80} class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Divider verticale -->
        <div class="hidden tablet:block self-stretch w-px bg-bc-black shrink-0 mx-[32px] xl:mx-0" />

        <!-- Titolo + Accordion dx: flex-1 fino a xl, 556px fissi da xl -->
        <div class="flex flex-col tablet:flex-1 xl:flex-none xl:w-[556px] xl:shrink-0 tablet:py-[64px]">
          <h2 class="font-sans font-normal text-bc-h4 text-bc-black tracking-[0.02em] mb-[16px]">
            {gruppo.titolo}
          </h2>

          {gruppo.servizi.map((s, idx) => (
            <details class="sv-acc group border-b border-bc-black" open={idx === 0}>
              <summary class="w-full flex items-center justify-between py-[16px] text-left cursor-pointer list-none">
                <span class="font-sans font-normal text-bc-h4 text-bc-black tracking-[0.02em]">{s.titolo}</span>
                <span class="sv-acc-icon shrink-0 w-[40px] h-[40px] flex items-center justify-center transition-transform duration-300">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <line x1="10" y1="0" x2="10" y2="20" stroke="black" stroke-width="1.5"/>
                    <line x1="0" y1="10" x2="20" y2="10" stroke="black" stroke-width="1.5"/>
                  </svg>
                </span>
              </summary>
              <div class="sv-acc-inner">
                <p class="font-sans font-light text-bc-body1 text-bc-black tracking-[0.02em]">{s.corpo}</p>
              </div>
            </details>
          ))}
        </div>

      </div>
    </section>
  ))}

  <!-- Partner: 3 colonne desktop, scroll orizzontale con snap su mobile/tablet — come SectionTeam -->
  <section class="w-full border-b border-bc-black px-[24px] tablet:px-bc-page">

    <!-- Desktop: 3 colonne con divider verticali -->
    <div class="hidden lg:flex lg:items-stretch mx-auto max-w-bc-content">
      {partner.map((p, i) => (
        <>
          {i > 0 && <div class="w-px bg-bc-black self-stretch shrink-0 mx-[40px]" />}
          <div class="flex flex-col gap-[32px] flex-1 py-[64px]">
            <div class="w-full bg-bc-black/10 overflow-hidden" style="aspect-ratio:327/407;">
              {p.image && <Image src={risolviImmagine(p.image)} alt={p.titolo} width={700} format="webp" quality={80} class="w-full h-full object-cover" />}
            </div>
            <div class="flex flex-col gap-bc-md">
              <h3 class="font-sans font-normal text-bc-h3 text-bc-black tracking-[0.02em]">{p.titolo}</h3>
              <p class="font-sans font-light text-bc-body2 text-bc-black tracking-[0.02em]">{p.testo}</p>
            </div>
          </div>
        </>
      ))}
    </div>

    <!-- Mobile + Tablet: scroll orizzontale con snap (sostituisce il carousel JS) -->
    <div class="lg:hidden mx-auto max-w-bc-content py-bc-2xl">
      <div class="flex justify-end gap-[8px] mb-bc-md">
        <button data-partner-prev class="w-[40px] h-[40px] flex items-center justify-center text-bc-black disabled:opacity-30 transition-opacity" aria-label="Precedente">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" fill="currentColor"/></svg>
        </button>
        <button data-partner-next class="w-[40px] h-[40px] flex items-center justify-center text-bc-black disabled:opacity-30 transition-opacity" aria-label="Successivo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 4L10.59 5.41L16.17 11H4V13H16.17L10.59 18.59L12 20L20 12L12 4Z" fill="currentColor"/></svg>
        </button>
      </div>
      <div class="flex gap-[16px] overflow-x-auto snap-x snap-mandatory pb-bc-xs" data-partner-track>
        {partner.map((p) => (
          <div class="flex-none snap-start flex flex-col gap-[32px] w-[85%] tablet:w-[calc(50%-8px)]">
            <div class="w-full bg-bc-black/10 overflow-hidden" style="aspect-ratio:327/407;">
              {p.image && <Image src={risolviImmagine(p.image)} alt={p.titolo} width={700} format="webp" quality={80} class="w-full h-full object-cover" />}
            </div>
            <div class="flex flex-col gap-bc-md">
              <h3 class="font-sans font-normal text-bc-h3 text-bc-black tracking-[0.02em]">{p.titolo}</h3>
              <p class="font-sans font-light text-bc-body2 text-bc-black tracking-[0.02em]">{p.testo}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </section>

  <!-- CTA finale -->
  <section class="w-full px-[24px] tablet:px-bc-page py-[64px] flex flex-col items-center gap-bc-2xl text-center">
    <p class="font-sans font-normal text-bc-body1 text-bc-black tracking-[0.02em] max-w-[442px]">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris rhoncus ipsum vel commodo lacinia. Etiam gravida sapien arcu, ac convallis elit bibendum quis.
    </p>
    <div>
      <a href="/contatti" class="bc-ghost">Contatta lo studio →</a>
    </div>
  </section>
</BaseLayout>

<script>
  const track = document.querySelector<HTMLElement>('[data-partner-track]');
  const prev  = document.querySelector<HTMLButtonElement>('[data-partner-prev]');
  const next  = document.querySelector<HTMLButtonElement>('[data-partner-next]');
  if (track && prev && next) {
    const step = () => {
      const card = track.querySelector<HTMLElement>('.snap-start');
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.9;
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left:  step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    requestAnimationFrame(update);
  }
</script>

<style>
  .sv-acc-inner {
    display: grid;
    grid-template-rows: 0fr;
    padding-top: 0;
    padding-bottom: 0;
    transition: grid-template-rows 0.35s ease, padding-top 0.35s ease, padding-bottom 0.35s ease;
  }
  .sv-acc-inner > p {
    overflow: hidden;
    min-height: 0;
  }
  .sv-acc[open] .sv-acc-inner {
    grid-template-rows: 1fr;
    padding-top: 16px;
    padding-bottom: 32px;
  }
  /* Stato di chiusura animata: forza i valori "chiusi" mentre open è ancora presente */
  .sv-acc[open].sv-acc-closing .sv-acc-inner {
    grid-template-rows: 0fr;
    padding-top: 0;
    padding-bottom: 0;
  }
  .sv-acc[open] .sv-acc-icon {
    transform: rotate(45deg);
  }
  .sv-acc[open].sv-acc-closing .sv-acc-icon {
    transform: rotate(0deg);
  }
  .sv-acc summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.sv-acc').forEach((details) => {
    details.addEventListener('click', (e) => {
      if (!details.open) return; // sta aprendo — lascia fare al browser
      e.preventDefault();
      details.classList.add('sv-acc-closing');
      details.querySelector('.sv-acc-inner')?.addEventListener('transitionend', () => {
        details.classList.remove('sv-acc-closing');
        details.removeAttribute('open');
      }, { once: true });
    });
  });
</script>
