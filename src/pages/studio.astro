---
// src/pages/studio.astro
// Porta 1:1 da app/pages/studio.vue.
// Task 17: il team arriva da Supabase (bc_team_members) via getTeamMembers(), non
// più dall'array `membri` hardcoded (Task 5).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBio from '../components/SectionBio.astro';
import SectionTeam from '../components/SectionTeam.astro';
import { getTeamMembers } from '../lib/supabase-public';
import { risolviImmagine } from '../utils/imagenes';

export const prerender = false;

// Fix code review Task 17: senza try/catch, un errore Supabase (rete, downtime,
// rate limit) qui produceva un 500 grezzo per qualunque visitatore pubblico.
// Fallback minimo: nessun membro — SectionTeam renderizza comunque (vedi nota
// sotto), niente banner/messaggio dedicato, non richiesto per questo fix.
let membriDb: Awaited<ReturnType<typeof getTeamMembers>> = [];
try {
  membriDb = await getTeamMembers();
} catch (err) {
  // Vedi nota gemella in src/pages/lavori/index.astro: senza log, un guasto di
  // config rende /studio silenziosamente vuota per ogni visitatore.
  console.error('[studio] getTeamMembers() ha fallito, fallback su team vuoto:', err)
  membriDb = []
}
const membri = membriDb.map((m) => ({
  nome: m.nome,
  ruolo: m.ruolo ?? '',
  bio: m.bio ?? '',
  // SectionTeam passa `image` a risolviImmagine(), che risolve solo path locali
  // noti tipo "/images/bc-NNN.jpg" (vedi src/utils/imagenes.ts) — nessuno dei 3
  // membri seedati (scripts/seed-bc-cms.mjs) ha ancora una foto (foto_url è null
  // per tutti). Se in futuro il CRUD team (Task 14) valorizza foto_url con un URL
  // remoto di Supabase Storage, quel valore non è risolvibile da risolviImmagine():
  // qui lo scartiamo esplicitamente invece di lasciarlo passare e far esplodere la
  // pagina pubblica in SSR per tutti i visitatori.
  image: m.foto_url && m.foto_url.startsWith('/images/') ? m.foto_url : undefined,
}));
// Non assumiamo che ci sia sempre almeno un membro: con `membri` un array vuoto
// (nessuna riga in bc_team_members), SectionTeam renderizza semplicemente una
// sezione senza card, senza crashare (il default placeholder del componente si
// attiva solo se la prop è del tutto omessa, non per un array vuoto esplicito).
---
<BaseLayout title="Lo Studio">
  <!-- Hero: stessa struttura della home — testo sx + foto quadrata dx -->
  <section class="w-full px-[24px] tablet:px-bc-page overflow-hidden">
    <div class="grid grid-cols-1 tablet:grid-cols-2 tablet:items-center max-w-bc-wrap mx-auto w-full">
      <div class="pt-[48px] pb-0 tablet:py-[80px] tablet:pr-[80px] flex flex-col gap-bc-xl justify-center">
        <h1 class="font-sans text-[28px] lg:text-bc-h1 font-normal text-bc-black tracking-[0.02em] leading-[1.5]">
          Lo studio&nbsp;&nbsp;Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris rhoncus ipsum vel commodo lacinia.
        </h1>
      </div>
      <div class="aspect-square overflow-hidden my-[32px]">
        <Image src={risolviImmagine('/images/bc-097.jpg')} alt="Lo studio di restauro" width={1000} format="webp" quality={80} class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <SectionBio imageSrc="/images/bc-030.jpg" imageAlt="Barbara Costantini" />
  <SectionTeam membri={membri} />
</BaseLayout>
