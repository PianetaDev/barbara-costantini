---
// src/layouts/AdminLayout.astro
// Layout dedicato all'area admin: niente Nav/Footer del sito pubblico.
// Sidebar laterale con le sezioni modificabili.
import '../styles/global.css';

interface Props {
  title: string;
  /** Mostra freccia "← Indietro" con l'href indicato */
  backHref?: string;
  backLabel?: string;
  /** Nasconde la sidebar (per pagine pre-autenticazione: login, reset password) */
  hideSidebar?: boolean;
}
const { title, backHref, backLabel = 'Indietro', hideSidebar = false } = Astro.props;
const path = Astro.url.pathname;

const navGroups = [
  {
    label: 'Contenuto',
    items: [
      { label: 'Lavori', href: '/admin/progetti' },
      { label: '+ Nuovo lavoro', href: '/admin/progetti/nuovo' },
      { label: 'Team', href: '/admin/team' },
      { label: '+ Nuovo membro', href: '/admin/team/nuovo' },
    ],
  },
  {
    label: 'Pagine',
    items: [
      { label: 'Home', href: '/admin/pagine/home' },
      { label: 'Studio', href: '/admin/pagine/studio' },
      { label: 'Contatti', href: '/admin/pagine/contatti' },
      { label: 'Servizi', href: '/admin/pagine/servizi' },
      { label: 'Privacy Policy', href: '/admin/pagine/privacy-policy' },
      { label: 'Cookie Policy', href: '/admin/pagine/cookie-policy' },
      { label: 'Footer', href: '/admin/pagine/footer' },
    ],
  },
];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Admin</title>
    <link rel="icon" href="/logo.svg" />
  </head>
  <body class="bg-bc-canvas text-bc-black font-sans min-h-screen flex">

    <!-- Sidebar -->
    {!hideSidebar && <aside class="w-[220px] shrink-0 border-r border-bc-black flex flex-col min-h-screen">
      <div class="px-[24px] py-[32px] border-b border-bc-black">
        <p class="font-sans text-[15px] font-normal text-bc-black tracking-[0.02em]">Admin</p>
      </div>
      <nav class="flex flex-col py-[16px] flex-1">
        {navGroups.map((group) => (
          <div class="mb-[8px]">
            <p class="px-[24px] py-[6px] font-sans text-[10px] uppercase tracking-widest text-bc-black/40">
              {group.label}
            </p>
            {group.items.map((item) => {
              const active = path === item.href || (item.href !== '/admin/progetti' && path.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class:list={[
                    'px-[24px] py-[8px] font-sans text-[14px] tracking-[0.02em] transition-colors block',
                    active
                      ? 'font-normal bg-bc-black text-bc-canvas'
                      : 'font-light hover:underline',
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </div>
        ))}
      </nav>
      <div class="px-[24px] py-[24px] border-t border-bc-black">
        <a href="/" target="_blank" rel="noopener noreferrer"
           class="bc-btn w-full text-center inline-flex items-center justify-center gap-[8px]">
          Vai al sito ↗
        </a>
      </div>
    </aside>}

    <!-- Contenuto principale -->
    {hideSidebar ? (
      <main class="flex-1 flex items-center justify-center px-[24px] py-[80px]">
        <slot />
      </main>
    ) : (
      <div class="flex-1 flex flex-col min-h-screen overflow-x-hidden">
        <!-- Topbar -->
        <header class="border-b border-bc-black px-[40px] py-[20px] flex items-center gap-[16px]">
          {backHref && (
            <a href={backHref} class="flex items-center justify-center w-[32px] h-[32px] text-bc-black shrink-0" aria-label={backLabel}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" fill="currentColor"/>
              </svg>
            </a>
          )}
          <h1 class="font-sans text-[18px] font-normal text-bc-black tracking-[0.02em]">{title}</h1>
        </header>

        <main class="flex-1 px-[40px] py-[40px]">
          <slot />
        </main>
      </div>
    )}

  </body>
</html>
