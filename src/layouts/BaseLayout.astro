---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Nav from '../components/Nav.vue';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.vue';
import PageTransition from '../components/PageTransition.astro';
import { leggiContenuto, inAnteprima } from '../lib/page-content';

interface Props {
  title: string;
  description?: string;
  titleIsFull?: boolean;
  /** Se true, nasconde la Nav globale — usare quando la pagina ha una nav propria (es. dettaglio lavoro). */
  hideNav?: boolean;
}
const {
  title,
  description = "Barbara Costantini Restauro — restauro conservativo di opere d'arte e beni culturali.",
  titleIsFull = false,
  hideNav = false,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
// Anteprima del pannello admin (iframe accanto al form): niente animazioni d'ingresso,
// niente banner cookie né widget segnalazioni, e la posizione di scroll si conserva
// tra un aggiornamento e l'altro mentre si scrive.
const anteprima = await inAnteprima(Astro);

// Widget segnalazioni "Segnale" → crea GitHub Issue su PianetaDev/barbara-costantini.
// data-source distingue chi segnala (pubblico del sito vs. team che lavora nell'admin),
// stessa convenzione già usata su Apotheke (vedi apotheke-cms-improvements).
const segnaleSource = Astro.url.pathname.startsWith('/admin') ? 'admin' : 'public';

// PIA-77: carica i dati del footer dal CMS una volta sola nel layout, evitando
// chiamate ridondanti in ogni pagina. getPageContent già gestisce errori internamente
// (ritorna {}); il try/catch è difesa extra contro eccezioni impreviste.
let footerContent: Record<string, string> = {};
try {
  footerContent = await leggiContenuto(Astro, 'footer');
} catch {
  // fallback: Footer usa i valori hardcoded di default
}
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleIsFull ? title : `${title} — Barbara Costantini Restauro`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.svg" />
    {!anteprima && <script is:inline>document.documentElement.classList.add('bc-l')</script>}
    {anteprima && (
      <Fragment>
        <meta name="robots" content="noindex" />
        <style is:inline>*,*::before,*::after{animation:none!important;transition:none!important}.bc-reveal{opacity:1!important;transform:none!important}</style>
      </Fragment>
    )}
    {isHome && (
      <Fragment>
        <link rel="preload" as="image" href="/images/bc-b/b-01.png" />
        <link rel="preload" as="image" href="/images/bc-b/b-02.png" />
        <link rel="preload" as="image" href="/images/bc-b/b-03.svg" type="image/svg+xml" />
        <link rel="preload" as="image" href="/images/bc-b/b-04.png" />
        <link rel="preload" as="image" href="/images/bc-b/b-05.png" />
        <link rel="preload" as="image" href="/images/bc-b/b-06.png" />
        <link rel="preload" as="image" href="/images/bc-b/b-07.png" />
        <link rel="preload" as="image" href="/images/bc-b/b-08.png" />
        <link rel="preload" as="image" href="/images/bc-b/b-09.png" />
      </Fragment>
    )}
    {!anteprima && <script
      is:inline
      src="https://segnale-phi.vercel.app/widget.js"
      defer
      data-project="barbara-costantini"
      data-source={segnaleSource}
    ></script>}
  </head>
  <body class="bg-bc-canvas text-bc-black font-sans">
    {isHome && !anteprima && <PageTransition />}
    {anteprima && (
      <script is:inline>
        (function () {
          var k = 'bc-anteprima-scroll:' + location.pathname;
          try {
            var y = Number(sessionStorage.getItem(k) || 0);
            if (y) window.addEventListener('load', function () { window.scrollTo(0, y); });
            window.addEventListener('scroll', function () { sessionStorage.setItem(k, String(window.scrollY)); }, { passive: true });
          } catch (e) {}
          // I link interni restano in anteprima (altrimenti al primo clic si esce dalla bozza).
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href^="/"]') : null;
            if (!a || a.getAttribute('href').indexOf('anteprima=1') !== -1) return;
            var u = new URL(a.href);
            u.searchParams.set('anteprima', '1');
            a.href = u.toString();
          }, true);
        })();
      </script>
    )}
    <script is:inline>
      if (window.location.pathname !== '/') {
        setTimeout(function() {
          document.documentElement.classList.remove('bc-l');
        }, 0);
      }
    </script>
    {!hideNav && <Nav client:load currentPath={Astro.url.pathname} />}
    <main>
      <slot />
    </main>
    <Footer content={footerContent} />
    {!anteprima && <CookieBanner client:load />}
    <script>
      function initReveal() {
        const html = document.documentElement;

        function addBcIn(target: Element) {
          if (!html.classList.contains('bc-l')) {
            target.classList.add('bc-in');
          } else {
            const mo = new MutationObserver(() => {
              if (!html.classList.contains('bc-l')) { mo.disconnect(); target.classList.add('bc-in'); }
            });
            mo.observe(html, { attributes: true, attributeFilter: ['class'] });
          }
        }

        const io = new IntersectionObserver((entries) => {
          for (const { target, isIntersecting } of entries) {
            if (!isIntersecting) continue;
            io.unobserve(target);
            if ((target as HTMLElement).dataset.waitForImg !== undefined) {
              const img = target.querySelector('img');
              if (!img || img.complete) {
                addBcIn(target);
              } else {
                img.addEventListener('load',  () => addBcIn(target), { once: true });
                img.addEventListener('error', () => addBcIn(target), { once: true });
              }
            } else {
              addBcIn(target);
            }
          }
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.06 });

        document.querySelectorAll('.bc-reveal').forEach(el => io.observe(el));
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
    </script>
  </body>
</html>
