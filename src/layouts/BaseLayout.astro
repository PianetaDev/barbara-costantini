---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Nav from '../components/Nav.vue';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.vue';

interface Props {
  title: string;
  description?: string;
  titleIsFull?: boolean;
  /** Se true, nasconde la Nav globale — usare quando la pagina ha una nav propria (es. dettaglio lavoro). */
  hideNav?: boolean;
}
const {
  title,
  description = "Barbara Costantini Restauro — restauro conservativo di opere d'arte e beni culturali.",
  titleIsFull = false,
  hideNav = false,
} = Astro.props;

// Widget segnalazioni "Segnale" → crea GitHub Issue su PianetaDev/barbara-costantini.
// data-source distingue chi segnala (pubblico del sito vs. team che lavora nell'admin),
// stessa convenzione già usata su Apotheke (vedi apotheke-cms-improvements).
const segnaleSource = Astro.url.pathname.startsWith('/admin') ? 'admin' : 'public';
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleIsFull ? title : `${title} — Barbara Costantini Restauro`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.svg" />
    <script
      is:inline
      src="https://segnale-phi.vercel.app/widget.js"
      defer
      data-project="barbara-costantini"
      data-source={segnaleSource}
    ></script>
  </head>
  <body class="bg-bc-canvas text-bc-black font-sans">
    {!hideNav && <Nav client:load currentPath={Astro.url.pathname} />}
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner client:load />
  </body>
</html>
