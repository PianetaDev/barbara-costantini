---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Nav from '../components/Nav.vue';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.vue';

interface Props {
  title: string;
  description?: string;
  /** Se true, {title} viene usato così com'è nel tag <title>, senza concatenare
   *  " — Barbara Costantini Restauro". Serve alle pagine il cui <title> originale
   *  (useHead di Nuxt) non seguiva quel pattern, es. la home ("Barbara Costantini
   *  Restauro" da solo, non "Home — Barbara Costantini Restauro"). */
  titleIsFull?: boolean;
}
const {
  title,
  description = "Barbara Costantini Restauro — restauro conservativo di opere d'arte e beni culturali.",
  titleIsFull = false,
} = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleIsFull ? title : `${title} — Barbara Costantini Restauro`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.svg" />
  </head>
  <body class="bg-bc-canvas text-bc-black font-sans">
    <Nav client:load currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner client:load />
  </body>
</html>
