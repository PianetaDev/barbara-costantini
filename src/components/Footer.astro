---
// Figma: 590:1427 — Footer Desktop — border-top, 1440×179
// Mobile 590:1897: colonna singola centrata
// Tablet 590:2197: two-column (sx info, dx link)
// Porta 1:1 da app/components/bc/Footer.vue — statico, nessuna interattività,
// diventa Astro puro (NuxtLink -> <a>).
// PIA-77: accetta `content` da BaseLayout (caricato da bc_page_content) con fallback
// ai valori hardcoded originali — Footer rimane statico, nessuna idratazione client.
interface Props {
  content?: Record<string, string>;
}
const { content = {} } = Astro.props;
const ragioneSociale = content.ragione_sociale || 'Barbara Costantini Restauro Srl';
const piva = content.piva || '14529501000';
const cf = content.cf || 'CSTBBR83M45H501C';
const annoCorrente = content.anno_copyright || String(new Date().getFullYear());
---
<footer class="w-full border-t border-bc-black mt-auto px-bc-page">
  <div class="max-w-bc-wrap mx-auto">
    <!-- Riga principale -->
    <div class="flex flex-col items-center md:flex-row md:items-end md:justify-between
                py-bc-xl gap-bc-xl md:gap-0">
      <!-- Info legali -->
      <div class="flex flex-col gap-bc-xs text-center md:text-left">
        <p class="font-sans text-bc-nav font-normal text-bc-black tracking-[0.02em]">
          {ragioneSociale}
        </p>
        <div class="flex flex-col gap-[8px]">
          <p class="font-sans text-bc-label2 font-light text-bc-black tracking-[0.02em]">P.IVA {piva}</p>
          <p class="font-sans text-bc-label2 font-light text-bc-black tracking-[0.02em]">C.F. {cf}</p>
        </div>
      </div>
      <!-- Link legali + copyright -->
      <div class="flex flex-col items-center md:items-end gap-[8px]">
        <div class="flex items-center gap-[6px]">
          <a href="/cookie-policy" class="font-sans text-bc-label2 font-light text-bc-black underline tracking-[0.02em]">Cookie Policy</a>
          <span class="font-sans text-bc-label2 font-light text-bc-black">|</span>
          <a href="/privacy-policy" class="font-sans text-bc-label2 font-light text-bc-black underline tracking-[0.02em]">Privacy Policy</a>
        </div>
        <p class="font-sans text-bc-label2 font-light text-bc-black tracking-[0.02em] text-center md:text-right">
          © {annoCorrente}, {ragioneSociale} · All Rights Reserved
        </p>
      </div>
    </div>
    <!-- Divider + credits -->
    <div class="border-t border-bc-black/20"></div>
    <div class="flex justify-center py-[16px]">
      <p class="font-sans text-bc-label2 font-light text-bc-black/60 text-center tracking-[0.02em]">
        Energy Class A+ GreenMeter · Designed by Pianeta.studio
      </p>
    </div>
  </div>
</footer>
