---
// src/components/PageTransition.astro
// Ogni cella ha 2 B in stack: la superiore scompare, quella sotto appare.
// Le 9 celle sono sfalsate (stagger 100ms) → flusso organico nella griglia.
const cells: [string, string][] = [
  ['/images/bc-b/b-01.png', '/images/bc-b/b-05.png'],
  ['/images/bc-b/b-02.png', '/images/bc-b/b-06.png'],
  ['/images/bc-b/b-03.svg', '/images/bc-b/b-07.png'],
  ['/images/bc-b/b-04.png', '/images/bc-b/b-08.png'],
  ['/images/bc-b/b-05.png', '/images/bc-b/b-09.png'],
  ['/images/bc-b/b-06.png', '/images/bc-b/b-01.png'],
  ['/images/bc-b/b-07.png', '/images/bc-b/b-02.png'],
  ['/images/bc-b/b-08.png', '/images/bc-b/b-03.svg'],
  ['/images/bc-b/b-09.png', '/images/bc-b/b-04.png'],
];
---

<div id="bc-t" aria-hidden="true">
  <div class="bc-t-grid">
    {cells.map(([a, b], i) => (
      <div class="bc-t-cell" style={`--d:${i * 100}ms`}>
        <img class="bc-a" src={a} alt="" width="47" height="47" draggable="false" />
        <img class="bc-b" src={b} alt="" width="47" height="47" draggable="false" />
      </div>
    ))}
  </div>
</div>

<style is:global>
  /* B superiore: appare → tiene → scompare */
  @keyframes bc-a {
    0%   { opacity: 0; }
    8%   { opacity: 1; }
    42%  { opacity: 1; }
    54%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* B sotto: aspetta → appare → tiene → scompare */
  @keyframes bc-b {
    0%   { opacity: 0; }
    50%  { opacity: 0; }
    62%  { opacity: 1; }
    92%  { opacity: 1; }
    100% { opacity: 0; }
  }

  html.bc-l body > *:not(#bc-t) {
    opacity: 0;
  }

  #bc-t {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #f7f6ef;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.6s ease-in-out;
    will-change: opacity;
  }
  #bc-t.bc-out {
    opacity: 0;
    pointer-events: none;
  }
  .bc-t-grid {
    display: grid;
    grid-template-columns: repeat(3, 47px);
    grid-template-rows: repeat(3, 47px);
    column-gap: 34px;
    row-gap: 14px;
  }
  .bc-t-cell {
    position: relative;
    width: 47px;
    height: 47px;
  }
  .bc-t-cell .bc-a,
  .bc-t-cell .bc-b {
    position: absolute;
    inset: 0;
    width: 47px;
    height: 47px;
    object-fit: contain;
    display: block;
    animation-duration: 1600ms;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-fill-mode: backwards;
    animation-delay: var(--d);
  }
  .bc-t-cell .bc-a { animation-name: bc-a; }
  .bc-t-cell .bc-b { animation-name: bc-b; }
</style>

<script>
  const overlay = document.getElementById('bc-t');
  if (overlay) {
    // Lascia ciclare ~1.5 volte poi fade-out
    setTimeout(() => overlay.classList.add('bc-out'), 2200);

    overlay.addEventListener('transitionend', () => {
      const nav = [...document.body.children]
        .find(c => c.id !== 'bc-t' && c.tagName !== 'MAIN' && c.tagName !== 'FOOTER') as HTMLElement | undefined;
      const sections = [...(document.querySelector('main')?.children ?? [])] as HTMLElement[];
      const footer = document.querySelector('footer') as HTMLElement | null;
      const items = [nav, ...sections, footer].filter((el): el is HTMLElement => el != null);

      items.forEach(el => {
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.45s ease-in-out';
      });
      document.documentElement.classList.remove('bc-l');

      items.forEach((el, i) => {
        setTimeout(() => { el.style.opacity = '1'; }, i * 120 + 16);
      });
    }, { once: true });
  }
</script>
