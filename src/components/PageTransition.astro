---
// src/components/PageTransition.astro
// Overlay di transizione: griglia 3×3 di B tipografiche su bc-canvas.
// Le B appaiono in sequenza (stagger 100ms, solo opacity), poi fade-out dell'intero overlay.
const cells = [
  '/images/bc-b/b-01.png',
  '/images/bc-b/b-02.png',
  '/images/bc-b/b-03.svg',
  '/images/bc-b/b-04.png',
  '/images/bc-b/b-05.png',
  '/images/bc-b/b-06.png',
  '/images/bc-b/b-07.png',
  '/images/bc-b/b-08.png',
  '/images/bc-b/b-09.png',
];
---

<div id="bc-t" aria-hidden="true">
  <div class="bc-t-grid">
    {cells.map((src, i) => (
      <div class="bc-t-cell" style={`--d:${i * 100}ms`}>
        <img src={src} alt="" width="47" height="47" draggable="false" />
      </div>
    ))}
  </div>
</div>

<style is:global>
  @keyframes bc-b-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  #bc-t {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #f7f6ef;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.7s ease-in-out;
    will-change: opacity;
  }
  #bc-t.bc-out {
    opacity: 0;
    pointer-events: none;
  }
  .bc-t-grid {
    display: grid;
    grid-template-columns: repeat(3, 47px);
    grid-template-rows: repeat(3, 47px);
    column-gap: 34px;
    row-gap: 14px;
  }
  .bc-t-cell {
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bc-t-cell img {
    width: 47px;
    height: 47px;
    object-fit: contain;
    display: block;
    opacity: 0;
    animation: bc-b-in 0.5s ease-in-out forwards;
    animation-delay: var(--d);
  }
</style>

<script>
  const el = document.getElementById('bc-t');
  if (el) {
    // ultima B: delay 800ms + durata 500ms = 1300ms — pausa 400ms → fade-out a 1700ms
    setTimeout(() => el.classList.add('bc-out'), 1700);
  }
</script>
