---
// src/components/PageTransition.astro
// Overlay di transizione: griglia 3×3 di B tipografiche su bc-canvas.
// Le B appaiono una per una (stagger 90ms), poi l'overlay fa fade-out.
const cells = [
  '/images/bc-b/b-01.png',
  '/images/bc-b/b-02.png',
  '/images/bc-b/b-03.svg',
  '/images/bc-b/b-04.png',
  '/images/bc-b/b-05.png',
  '/images/bc-b/b-06.png',
  '/images/bc-b/b-07.png',
  '/images/bc-b/b-08.png',
  '/images/bc-b/b-09.png',
];
---

<div id="bc-t" aria-hidden="true">
  <div class="bc-t-grid">
    {cells.map((src, i) => (
      <div class="bc-t-cell" style={`--d:${i * 90}ms`}>
        <img src={src} alt="" width="47" height="47" draggable="false" />
      </div>
    ))}
  </div>
</div>

<style is:global>
  @keyframes bc-b-in {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  #bc-t {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #f7f6ef;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.6s ease;
    will-change: opacity;
  }
  #bc-t.bc-out {
    opacity: 0;
    pointer-events: none;
  }
  .bc-t-grid {
    display: grid;
    grid-template-columns: repeat(3, 47px);
    grid-template-rows: repeat(3, 47px);
    column-gap: 34px;
    row-gap: 14px;
  }
  .bc-t-cell {
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bc-t-cell img {
    width: 47px;
    height: 47px;
    object-fit: contain;
    display: block;
    opacity: 0;
    animation: bc-b-in 0.35s ease forwards;
    animation-delay: var(--d);
  }
</style>

<script>
  const el = document.getElementById('bc-t');
  if (el) {
    // ultima B appare a 720ms (8*90 + 350ms anim) — aspetto altri 300ms poi fade-out
    setTimeout(() => el.classList.add('bc-out'), 1350);
    el.addEventListener('transitionend', () => { el.style.display = 'none'; }, { once: true });
  }
</script>
