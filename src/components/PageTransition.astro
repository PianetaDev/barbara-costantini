---
// src/components/PageTransition.astro
// Ogni cella ha 2 B in stack che si alternano in cross-fade (stagger 100ms).
// Sotto la griglia: "Barbara Costantini Restauro" appare parola per parola.
const cells: [string, string][] = [
  ['/images/bc-b/b-01.png', '/images/bc-b/b-05.png'],
  ['/images/bc-b/b-02.png', '/images/bc-b/b-06.png'],
  ['/images/bc-b/b-03.svg', '/images/bc-b/b-07.png'],
  ['/images/bc-b/b-04.png', '/images/bc-b/b-08.png'],
  ['/images/bc-b/b-05.png', '/images/bc-b/b-09.png'],
  ['/images/bc-b/b-06.png', '/images/bc-b/b-01.png'],
  ['/images/bc-b/b-07.png', '/images/bc-b/b-02.png'],
  ['/images/bc-b/b-08.png', '/images/bc-b/b-03.svg'],
  ['/images/bc-b/b-09.png', '/images/bc-b/b-04.png'],
];

const words = ['Barbara', 'Costantini', 'Restauro'];
---

<div id="bc-t" aria-hidden="true">
  <div class="bc-t-grid">
    {cells.map(([a, b], i) => (
      <div class="bc-t-cell" style={`--d:${i * 100}ms`}>
        <img class="bc-a" src={a} alt="" width="47" height="47" draggable="false" />
        <img class="bc-b" src={b} alt="" width="47" height="47" draggable="false" />
      </div>
    ))}
  </div>

  <p class="bc-t-name">
    {words.map((word, i) => (
      <span style={`--wd:${600 + i * 160}ms`}>{word}</span>
    ))}
  </p>
</div>

<style is:global>
  /* B superiore: appare → tiene → scompare */
  @keyframes bc-a {
    0%   { opacity: 0; }
    8%   { opacity: 1; }
    42%  { opacity: 1; }
    54%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* B sotto: aspetta → appare → tiene → scompare */
  @keyframes bc-b {
    0%   { opacity: 0; }
    50%  { opacity: 0; }
    62%  { opacity: 1; }
    92%  { opacity: 1; }
    100% { opacity: 0; }
  }

  /* Parole del titolo */
  @keyframes bc-word {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Nasconde nav, sezioni e footer prima che l'overlay esca */
  html.bc-l #bc-nav,
  html.bc-l main > *,
  html.bc-l footer {
    opacity: 0;
    transform: translateY(18px);
  }

  /* Transitions CSS-only — il browser le usa all'uscita da bc-l, zero JS */
  html.bc-l #bc-nav {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  html.bc-l main > *:nth-child(1) {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    transition-delay: 80ms;
  }
  html.bc-l main > *:nth-child(2) {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    transition-delay: 160ms;
  }
  html.bc-l main > *:nth-child(3) {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    transition-delay: 240ms;
  }
  html.bc-l main > *:nth-child(4) {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    transition-delay: 320ms;
  }
  html.bc-l footer {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    transition-delay: 200ms;
  }

  #bc-t {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #f7f6ef;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
    transition: opacity 0.6s ease-in-out;
    will-change: opacity;
  }
  #bc-t.bc-out {
    opacity: 0;
    pointer-events: none;
  }

  .bc-t-grid {
    display: grid;
    grid-template-columns: repeat(3, 47px);
    grid-template-rows: repeat(3, 47px);
    column-gap: 34px;
    row-gap: 14px;
  }
  .bc-t-cell {
    position: relative;
    width: 47px;
    height: 47px;
  }
  .bc-t-cell .bc-a,
  .bc-t-cell .bc-b {
    position: absolute;
    inset: 0;
    width: 47px;
    height: 47px;
    object-fit: contain;
    display: block;
    animation-duration: 1600ms;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-fill-mode: backwards;
    animation-delay: var(--d);
  }
  .bc-t-cell .bc-a { animation-name: bc-a; }
  .bc-t-cell .bc-b { animation-name: bc-b; }

  .bc-t-name {
    font-family: inherit;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1a1a18;
    display: flex;
    gap: 0.6em;
  }
  .bc-t-name span {
    opacity: 0;
    animation: bc-word 0.5s ease-in-out forwards;
    animation-delay: var(--wd);
  }
</style>

<script>
  const overlay = document.getElementById('bc-t');
  if (overlay) {
    setTimeout(() => overlay.classList.add('bc-out'), 2200);

    overlay.addEventListener('transitionend', () => {
      // Il CSS gestisce tutto: transitions + stagger via transition-delay
      document.documentElement.classList.remove('bc-l');
    }, { once: true });
  }
</script>
