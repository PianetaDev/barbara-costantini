---
// src/components/SectionServizi.astro
// Figma: 761:3281 — section 3 "I servizi" — full-width, immagine sx + testo dx
// Porta 1:1 da app/components/bc/SectionServizi.vue.
// L'originale Vue usa <slot> per immagine/body/cta (per riuso in altre pagine);
// qui li rendiamo prop opzionali con gli stessi default del componente Vue,
// dato che in questo task l'unico utilizzo reale è da index.vue (che passa
// solo l'immagine bc-002.jpg via slot #image e lascia body/cta di default).
interface Props {
  imageSrc?: string;
  imageAlt?: string;
  body?: string;
  ctaHref?: string;
  ctaLabel?: string;
}
const {
  imageSrc = '/images/bc-002.jpg',
  imageAlt = 'I servizi',
  body = 'I Servizi Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris rhoncus ipsum vel commodo lacinia.',
  ctaHref = '/servizi',
  ctaLabel = 'Scopri i servizi →',
} = Astro.props;
---
<section class="w-full px-[24px] tablet:px-bc-page overflow-hidden">
  <div class="grid grid-cols-1 tablet:grid-cols-2 gap-y-[24px] tablet:gap-y-0 py-[48px] tablet:py-0 max-w-bc-wrap mx-auto w-full">

    <!-- Immagine sx: riempie la colonna, quadrata -->
    <div class="flex items-center tablet:py-[32px]">
      <div class="w-full aspect-square bg-bc-black/10 overflow-hidden">
        <img src={imageSrc} alt={imageAlt} class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- Testo + CTA dx: centrato nella colonna dx -->
    <div class="flex items-center justify-center tablet:pl-[40px] lg:pl-0">
      <div class="flex flex-col gap-bc-xl justify-center lg:w-[442px] tablet:py-[80px]">
        <p class="font-sans text-bc-body1 font-light text-bc-black tracking-[0.02em]">
          {body}
        </p>
        <a href={ctaHref} class="bc-ghost">{ctaLabel}</a>
      </div>
    </div>

  </div>
</section>
