# Sanity CMS (Parte 2, non ancora integrato — Foss configura questi valori)
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Supabase — progetto condiviso "pianeta-xp" (ref fmplfkzqexaposaamgwi), vedi supabase/README.md
# Lato server: usate in src/lib/supabase.ts (middleware, endpoint /api/admin/*)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: non ancora usata da nessun endpoint in questo repo (nessun task l'ha
# richiesta finora); tenerla qui pronta per quando servirà un'operazione che deve bypassare
# la RLS (es. l'invito utenti del Task 12 lato server). Non esporre mai al client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase lato client — prefisso PUBLIC_ richiesto da Astro per esporre la variabile al
# browser. Usate in src/pages/admin/imposta-password.astro per completare il flusso di
# reset password (il token di recovery arriva nel fragment dell'URL, gestito solo client-side).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
