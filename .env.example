# Sanity CMS (Parte 2, non ancora integrato — Foss configura questi valori)
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Supabase — progetto condiviso "pianeta-xp" (ref fmplfkzqexaposaamgwi), vedi supabase/README.md
# Lato server: usate in src/lib/supabase.ts (middleware, endpoint /api/admin/*)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: non ancora usata da nessun endpoint in questo repo (nessun task l'ha
# richiesta finora); tenerla qui pronta per quando servirà un'operazione che deve bypassare
# la RLS (es. l'invito utenti del Task 12 lato server). Non esporre mai al client.
SUPABASE_SERVICE_ROLE_KEY=

# NOTA: non servono variabili PUBLIC_SUPABASE_* — il flusso di reset password
# (src/pages/admin/imposta-password.astro) è interamente server-side: scambia il `code`
# ricevuto in query string per una sessione con lo stesso client server-side di
# src/lib/supabase.ts (stessi cookie del code-verifier PKCE), non con un client browser
# separato. Vedi il commit "fix: risolve reset-password rotto" per il perché — un client
# browser con storage/flow diverso (localStorage, implicit flow) non condivide lo stato
# col client server-side e fa fallire lo scambio.
